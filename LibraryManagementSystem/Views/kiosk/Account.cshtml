@model LibraryManagementSystem.ViewModels.KioskAccountViewModel
@using System.Globalization

@{
    Layout = null;
    var currency = CultureInfo.GetCultureInfo("en-AU");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#20211f" />

    <title>My account | LibraryLink NT</title>

    <style>
        :root {
            color-scheme: light;
            font-family: "Segoe UI", system-ui, sans-serif;
            color: #242424;
            background: #f7f5f0;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            background:
                radial-gradient(
                    ellipse at 100% 0%,
                    rgba(233, 188, 98, .12),
                    transparent 45%
                ),
                #f7f5f0;
            line-height: 1.65;
        }

        ::selection {
            background: #e9bc62;
            color: #20211f;
        }

        :focus-visible {
            outline: 3px solid #916216;
            outline-offset: 5px;
        }

        .skip-link {
            position: fixed;
            top: -120px;
            left: 20px;
            z-index: 100;
            padding: 14px 20px;
            border-radius: 10px;
            background: #e9bc62;
            color: #20211f;
            font-weight: 700;
        }

        .skip-link:focus {
            top: 16px;
        }

        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
            max-width: 1400px;
            margin: auto;
            padding: 24px 5%;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #20211f;
            font-size: 1.25rem;
            font-weight: 800;
            letter-spacing: -.045em;
        }

        .brand-icon {
            display: grid;
            place-items: center;
            width: 44px;
            height: 46px;
            border-radius: 12px 12px 4px 12px;
            background: #20211f;
            color: #e9bc62;
        }

        .brand-icon svg {
            width: 26px;
            height: 26px;
        }

        .brand small {
            display: block;
            margin-top: 3px;
            color: #65635e;
            font-size: .65rem;
            font-weight: 600;
            letter-spacing: .13em;
        }

        button,
        .button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            min-height: 52px;
            padding: 12px 22px;
            border: 1px solid #e9bc62;
            border-radius: 12px;
            background: #e9bc62;
            color: #20211f;
            font: inherit;
            font-weight: 700;
            text-align: center;
            text-decoration: none;
            cursor: pointer;
            transition:
                transform 180ms ease,
                background-color 180ms ease,
                box-shadow 180ms ease;
        }

        button:hover,
        .button:hover {
            background: #f1cb80;
        }

        button:active,
        .button:active {
            transform: scale(.98);
        }

        .finish-button {
            border-color: #bcb5a6;
            background: transparent;
            color: #34332e;
            font-size: .85rem;
        }

        .finish-button:hover {
            background: #eee7d8;
        }

        main {
            width: min(90%, 1200px);
            margin: 20px auto;
        }

        .welcome {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 24px;
            padding: clamp(28px, 4vw, 48px);
            border: 1px solid #3c3d35;
            border-radius: 26px;
            background:
                radial-gradient(
                    ellipse at 100% 0%,
                    rgba(233, 188, 98, .16),
                    transparent 65%
                ),
                #20211f;
            color: #fffdf6;
        }

        .welcome > div {
            min-width: 0;
            flex: 1 1 300px;
        }

        .eyebrow {
            color: #e9bc62;
            font-size: .72rem;
            font-weight: 750;
            letter-spacing: .16em;
            text-transform: uppercase;
        }

        h1 {
            margin: 14px 0;
            color: #fffdf6;
            font-size: clamp(2.2rem, 4vw, 3.5rem);
            line-height: 1.15;
            letter-spacing: -.055em;
            overflow-wrap: anywhere;
        }

        .welcome-copy {
            max-width: 500px;
            margin-bottom: 0;
            color: #cbc9bf;
            line-height: 1.8;
        }

        .welcome .button {
            min-height: 60px;
            padding: 16px 26px;
        }

        .summary {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px;
            margin: 24px 0 36px;
        }

        .card {
            min-width: 0;
            padding: 26px;
            border: 1px solid #e5e0d6;
            border-radius: 20px;
            background: #fff;
            box-shadow: 0 10px 30px rgba(32, 33, 31, .04);
        }

        .metric-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .metric-label {
            color: #65635e;
            font-size: .9rem;
            font-weight: 650;
        }

        .metric-icon {
            display: grid;
            place-items: center;
            flex: 0 0 40px;
            width: 40px;
            height: 40px;
            border: 1px solid #e4d5b3;
            border-radius: 12px;
            background: #fbf4e5;
            color: #705016;
            font-weight: 750;
        }

        .value {
            display: block;
            margin: 12px 0 6px;
            color: #20211f;
            font-size: 2.8rem;
            font-weight: 700;
            line-height: 1.2;
            letter-spacing: -.05em;
            overflow-wrap: anywhere;
        }

        .muted {
            color: #65635e;
            line-height: 1.7;
        }

        .metric-note {
            margin: 0;
            font-size: .8rem;
        }

        .section-heading {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 18px;
        }

        h2 {
            margin: 0;
            color: #20211f;
            font-size: 1.45rem;
            line-height: 1.3;
            letter-spacing: -.035em;
        }

        .section-heading p {
            margin: 0;
            font-size: .85rem;
        }

        .loans {
            display: grid;
            gap: 14px;
        }

        .loan {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 20px;
            padding: 22px 26px;
        }

        .item-information {
            display: flex;
            align-items: center;
            flex: 1 1 250px;
            gap: 18px;
            min-width: 0;
        }

        .item-mark {
            display: grid;
            place-items: center;
            flex: 0 0 48px;
            height: 60px;
            border-left: 5px solid #a7833e;
            border-radius: 5px 10px 10px 5px;
            background: #f0e5cb;
            color: #705016;
            font-size: 1.3rem;
        }

        .item-text {
            min-width: 0;
        }

        h3 {
            margin: 0 0 5px;
            color: #20211f;
            font-size: 1rem;
            line-height: 1.4;
            overflow-wrap: anywhere;
        }

        .item-code {
            margin: 0;
            font-family: Consolas, monospace;
            font-size: .8rem;
            overflow-wrap: anywhere;
        }

        .loan-details {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 22px;
        }

        .due-label {
            display: block;
            margin-bottom: 3px;
            color: #65635e;
            font-size: .72rem;
        }

        time {
            font-size: .9rem;
            font-weight: 700;
        }

        .status {
            padding: 6px 12px;
            border: 1px solid #e3d2ac;
            border-radius: 100px;
            background: #fbf2df;
            color: #795714;
            font-size: .75rem;
            font-weight: 750;
        }

        .overdue {
            border-color: #ebc7c9;
            background: #fff0f1;
            color: #922f38;
        }

        .empty {
            padding: 40px 26px;
            text-align: center;
        }

        .empty h3 {
            margin-bottom: 10px;
            font-size: 1.2rem;
        }

        .empty p {
            margin-bottom: 0;
        }

        .notice {
            margin: 24px 0;
            padding: 18px 22px;
            border: 1px solid #dfc994;
            border-radius: 14px;
            background: #fbf3df;
            color: #674c17;
            line-height: 1.7;
            overflow-wrap: anywhere;
        }

        .support {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            margin: 28px 0;
            padding: 22px 24px;
            border: 1px dashed #c7b996;
            border-radius: 16px;
            background: #fbf8f0;
        }

        .help-icon {
            display: grid;
            place-items: center;
            flex: 0 0 28px;
            height: 28px;
            border: 1px solid #a9915c;
            border-radius: 50%;
            color: #705016;
            font-weight: 700;
        }

        .support strong {
            font-size: .9rem;
        }

        .support p {
            margin: 5px 0 0;
            font-size: .8rem;
        }

        footer {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            width: min(90%, 1200px);
            margin: auto;
            padding: 16px 0 28px;
            color: #65635e;
            font-size: .75rem;
        }

        dialog {
            width: min(90%, 480px);
            padding: 30px;
            border: 1px solid #dfd3b7;
            border-radius: 22px;
            background: #fffdf8;
            color: #242424;
            box-shadow: 0 30px 90px rgba(0, 0, 0, .25);
        }

        dialog::backdrop {
            background: rgba(25, 25, 22, .82);
        }

        dialog p {
            line-height: 1.7;
        }

        dialog button {
            width: 100%;
            margin-top: 12px;
        }

        .secondary {
            border-color: #bcb5a6;
            background: #eee9dd;
            color: #34332e;
        }

        .secondary:hover {
            background: #e2dac9;
        }

        #kiosk-accessibility {
            justify-content: flex-end;
            gap: 8px !important;
            width: min(90%, 1200px);
            margin: auto;
            padding: 8px 0 12px !important;
            border: 0 !important;
            background: transparent !important;
        }

        #kiosk-accessibility .accessibility-label {
            color: #65635e;
            font-size: .75rem;
        }

        #kiosk-accessibility button {
            min-height: 44px !important;
            padding: 8px 12px !important;
            border-width: 1px !important;
            border-radius: 9px !important;
            font-size: .75rem !important;
        }

        html.kiosk-high-contrast .welcome,
        html.kiosk-high-contrast .brand-icon,
        html.kiosk-high-contrast .metric-icon,
        html.kiosk-high-contrast .item-mark,
        html.kiosk-high-contrast .support,
        html.kiosk-high-contrast dialog {
            border-color: #fff !important;
            background: #000 !important;
            color: #fff !important;
        }

        html.kiosk-high-contrast h1,
        html.kiosk-high-contrast h2,
        html.kiosk-high-contrast h3,
        html.kiosk-high-contrast .value,
        html.kiosk-high-contrast .welcome-copy,
        html.kiosk-high-contrast .metric-label,
        html.kiosk-high-contrast .due-label,
        html.kiosk-high-contrast .brand,
        html.kiosk-high-contrast .brand small,
        html.kiosk-high-contrast .eyebrow,
        html.kiosk-high-contrast .help-icon,
        html.kiosk-high-contrast .accessibility-label {
            color: #fff !important;
        }

        @@media (hover: hover) and (pointer: fine) {
            button:hover,
            .button:hover {
                transform: translateY(-2px) scale(1.04);
                box-shadow: 0 10px 24px rgba(32, 33, 31, .14);
            }
        }

        @@media (max-width: 700px) {
            .summary {
                grid-template-columns: 1fr;
            }

            .welcome .button {
                width: 100%;
            }

            .loan-details {
                justify-content: space-between;
                width: 100%;
            }

            #kiosk-accessibility {
                justify-content: flex-start;
            }
        }

        @@media (max-width: 420px) {
            header {
                padding-top: 20px;
            }

            #end-session {
                width: 100%;
            }

            .finish-button {
                width: 100%;
            }

            .loan,
            .card {
                padding: 22px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation: none !important;
                transition: none !important;
            }

            button:hover,
            button:active,
            .button:hover,
            .button:active {
                transform: none !important;
            }
        }
    </style>
</head>

<body>
    <a class="skip-link" href="#main-content">
        Skip to main content
    </a>

    <header>
        <div class="brand">
            <span class="brand-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     focusable="false">
                    <path d="M16 8C11 4 5 6 4 7v19c4-2 8-2 12 1
                             4-3 8-3 12-1V7c-1-1-7-3-12 1Z" />
                    <path d="M16 8v19" />
                </svg>
            </span>

            <div>
                LibraryLink NT
                <small>YOUR NEXT CHAPTER STARTS HERE</small>
            </div>
        </div>

        <form method="post"
              action="@Url.Action("EndSession", "Kiosk")"
              id="end-session">

            @Html.AntiForgeryToken()

            <button type="submit" class="finish-button">
                Finish session
                <span aria-hidden="true">↗</span>
            </button>
        </form>
    </header>

    <main id="main-content" tabindex="-1">
        <section class="welcome"
                 aria-labelledby="welcome-heading">

            <div>
                <div class="eyebrow">
                    Your own little corner
                </div>

                <h1 id="welcome-heading">
                    Hello, @Model.FirstName.
                </h1>

                <p class="welcome-copy">
                    A new discovery is always around the corner.
                    Check your loans or find something new to take home.
                </p>
            </div>

            <a href="@Url.Action("Borrow", "Kiosk")"
               class="button">
                Borrow an item
                <span aria-hidden="true">→</span>
            </a>
        </section>

        @if (TempData["KioskMessage"] is string message)
        {
            <div class="notice" role="status">
                @message
            </div>
        }

        <div class="summary">
            <section class="card" aria-label="Active loans">
                <div class="metric-top">
                    <span class="metric-label">
                        Currently borrowing
                    </span>

                    <span class="metric-icon" aria-hidden="true">
                        ↗
                    </span>
                </div>

                <strong class="value">
                    @Model.ActiveLoans.Count
                </strong>

                <p class="muted metric-note">
                    Items on your account
                </p>
            </section>

            <section class="card"
                     aria-label="Unpaid assessed fines">

                <div class="metric-top">
                    <span class="metric-label">
                        Unpaid assessed fines
                    </span>

                    <span class="metric-icon" aria-hidden="true">
                        $
                    </span>
                </div>

                <strong class="value">
                    @Model.OutstandingFines.ToString("C", currency)
                </strong>

                <p class="muted metric-note">
                    Further charges may apply when overdue items return.
                </p>
            </section>
        </div>

        <section aria-labelledby="loans-heading">
            <div class="section-heading">
                <h2 id="loans-heading">
                    On your bookshelf
                </h2>

                <p class="muted">
                    Your current loans and return dates
                </p>
            </div>

            @if (Model.ActiveLoans.Count == 0)
            {
                <div class="card empty">
                    <h3>A little space for something new.</h3>

                    <p class="muted">
                        You have no active loans.
                        Select “Borrow an item” to get started.
                    </p>
                </div>
            }
            else
            {
                <div class="loans">
                    @foreach (var loan in Model.ActiveLoans)
                    {
                        <article class="card loan">
                            <div class="item-information">
                                <div class="item-mark"
                                     aria-hidden="true">
                                    ↗
                                </div>

                                <div class="item-text">
                                    <h3>@loan.ItemName</h3>

                                    <p class="muted item-code">
                                        @loan.LibraryCode
                                    </p>
                                </div>
                            </div>

                            <div class="loan-details">
                                <div>
                                    <span class="due-label">
                                        Return by
                                    </span>

                                    <time datetime="@loan.DueDate.ToString("yyyy-MM-dd")">
                                        @loan.DueDate.ToString("dd MMM yyyy")
                                    </time>
                                </div>

                                <span class="status @(loan.IsOverdue ? "overdue" : "")">
                                    @(loan.IsOverdue ? "Overdue" : "On loan")
                                </span>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <aside class="support" aria-label="Help">
            <span class="help-icon" aria-hidden="true">
                ?
            </span>

            <div>
                <strong>We’re here if you need us.</strong>

                <p class="muted">
                    Visit the service desk for account questions
                    or fine payments. Finish your session before
                    leaving the kiosk.
                </p>
            </div>
        </aside>

        <noscript>
            <p>
                Automatic screen clearing requires JavaScript.
                Use “Finish session” before leaving.
            </p>
        </noscript>
    </main>

    <dialog id="timeout-dialog"
            aria-labelledby="timeout-heading"
            aria-describedby="timeout-description">

        <h2 id="timeout-heading">
            Still exploring?
        </h2>

        <p id="timeout-description">
            Your session will finish in
            <strong id="seconds-left">30</strong> seconds.
        </p>

        <button type="button" id="continue-session">
            Yes, keep my session open
        </button>

        <button type="button"
                id="finish-now"
                class="secondary">
            Finish now
        </button>
    </dialog>

    <footer>
        <span>
            LibraryLink NT · Group 11 demonstration
        </span>

        <span>
            Your visit. Your discoveries. Your library.
        </span>
    </footer>

    <script>
        (() => {
            const form = document.getElementById("end-session");
            const dialog = document.getElementById("timeout-dialog");
            const seconds = document.getElementById("seconds-left");
            const continueButton =
                document.getElementById("continue-session");

            let lastActivity = Date.now();
            let ending = false;

            function finish() {
                if (ending) return;

                ending = true;
                document.body.style.visibility = "hidden";
                form.requestSubmit();
            }

            function activity() {
                if (!dialog.open && !ending) {
                    lastActivity = Date.now();
                }
            }

            ["pointerdown", "keydown", "touchstart"].forEach(event => {
                document.addEventListener(event, activity, {
                    passive: true
                });
            });

            continueButton.addEventListener("click", () => {
                window.location.reload();
            });

            document.getElementById("finish-now")
                .addEventListener("click", finish);

            dialog.addEventListener("cancel", event => {
                event.preventDefault();
            });

            function checkTimeout() {
                if (ending) return;

                const elapsed = Date.now() - lastActivity;

                if (elapsed >= 90000) {
                    finish();
                    return;
                }

                if (elapsed >= 60000) {
                    seconds.textContent =
                        Math.ceil((90000 - elapsed) / 1000);

                    if (!dialog.open) {
                        dialog.showModal();
                        continueButton.focus();
                    }
                }
            }

            setInterval(checkTimeout, 1000);

            document.addEventListener(
                "visibilitychange",
                checkTimeout
            );

            window.addEventListener("pageshow", event => {
                if (event.persisted) {
                    window.location.reload();
                }
            });
        })();
    </script>

    <script src="@Url.Content("~/js/kiosk-accessibility.js")"
            asp-append-version="true"></script>
</body>
</html>B