@model LibraryManagementSystem.ViewModels.KioskAccountViewModel
@using System.Globalization

@{
    Layout = null;
    var currency = CultureInfo.GetCultureInfo("en-AU");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>My account | LibraryLink NT</title>

    <style>
            :root {
                font-family: "Segoe UI", system-ui, sans-serif;
                color: #153b36;
                background: #f6f7f2;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
            }

            :focus-visible {
                outline: 3px solid #ac4800;
                outline-offset: 5px;
            }

            .skip-link {
                position: absolute;
                left: 20px;
                top: -100px;
                z-index: 20;
                padding: 16px;
                background: white;
                color: #075e51;
            }

                .skip-link:focus {
                    top: 16px;
                }

            header {
                max-width: 1400px;
                margin: auto;
                padding: 24px 5%;
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 16px;
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 12px;
                font-size: 1.25rem;
                font-weight: 800;
                letter-spacing: -.045em;
            }

            .brand-icon {
                display: grid;
                place-items: center;
                width: 44px;
                height: 44px;
                border-radius: 14px;
                background: #075e51;
                color: white;
            }

                .brand-icon svg {
                    width: 26px;
                    height: 26px;
                }

            .brand small {
                display: block;
                font-size: .68rem;
                letter-spacing: .15em;
                font-weight: 600;
                color: #526b63;
            }

            button, .button {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 12px;
                min-height: 52px;
                padding: 12px 22px;
                border: 1px solid transparent;
                border-radius: 12px;
                background: #075e51;
                color: white;
                font: inherit;
                font-weight: 700;
                text-align: center;
                text-decoration: none;
                cursor: pointer;
            }

                button:hover, .button:hover {
                    background: #03483e;
                }

            .finish-button {
                background: transparent;
                color: #153b36;
                border-color: #aabcb0;
                font-size: .85rem;
            }

                .finish-button:hover {
                    background: #e5ece2;
                }

            main {
                width: min(90%, 1200px);
                margin: 20px auto;
            }

            .welcome {
                position: relative;
                padding: clamp(28px, 4vw, 48px);
                border-radius: 26px;
                background: #073f37;
                color: white;
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
                gap: 24px;
            }

            .eyebrow {
                font-size: .72rem;
                text-transform: uppercase;
                letter-spacing: .16em;
                font-weight: 750;
                color: #c5e3cc;
            }

            h1 {
                margin: 14px 0 10px;
                font-size: clamp(2.2rem, 4vw, 3.5rem);
                letter-spacing: -.055em;
                line-height: 1.15;
                overflow-wrap: anywhere;
            }

            .welcome-copy {
                color: #d0e2d9;
                margin-bottom: 0;
                line-height: 1.7;
            }

            .welcome .button {
                background: #d8ecad;
                color: #153b36;
                min-height: 60px;
                padding: 16px 26px;
            }

                .welcome .button:hover {
                    background: #c7e18f;
                }

            .summary {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 20px;
                margin: 24px 0 36px;
            }

            .card {
                background: white;
                border: 1px solid #dce4db;
                border-radius: 20px;
                padding: 26px;
                min-width: 0;
            }

            .metric-top {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
            }

            .metric-label {
                color: #526b63;
                font-size: .9rem;
                font-weight: 650;
            }

            .metric-icon {
                display: grid;
                place-items: center;
                width: 40px;
                height: 40px;
                background: #edf3e5;
                color: #075e51;
                border-radius: 12px;
                font-weight: 750;
            }

            .value {
                display: block;
                margin: 12px 0 6px;
                font-size: 2.8rem;
                line-height: 1.2;
                font-weight: 700;
                letter-spacing: -.05em;
                overflow-wrap: anywhere;
            }

            .muted {
                color: #526b63;
                line-height: 1.7;
            }

            .metric-note {
                font-size: .8rem;
                margin: 0;
            }

            .section-heading {
                display: flex;
                justify-content: space-between;
                align-items: baseline;
                flex-wrap: wrap;
                gap: 12px;
                margin-bottom: 18px;
            }

            h2 {
                margin: 0;
                font-size: 1.45rem;
                letter-spacing: -.035em;
            }

            .section-heading p {
                margin: 0;
                font-size: .85rem;
            }

            .loans {
                display: grid;
                gap: 14px;
            }

            .loan {
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 20px;
                padding: 22px 26px;
            }

            .item-information {
                display: flex;
                align-items: center;
                gap: 18px;
                min-width: 0;
            }

            .item-mark {
                flex: 0 0 48px;
                height: 60px;
                border-radius: 5px 10px 10px 5px;
                background: #e1eacb;
                border-left: 5px solid #7b956b;
                display: grid;
                place-items: center;
                color: #315b3d;
                font-size: 1.3rem;
            }

            .item-text {
                min-width: 0;
            }

            h3 {
                font-size: 1rem;
                margin: 0 0 5px;
                overflow-wrap: anywhere;
            }

            .item-code {
                margin: 0;
                font-size: .8rem;
                overflow-wrap: anywhere;
            }

            .loan-details {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 22px;
            }

            .due-label {
                font-size: .72rem;
                color: #526b63;
                display: block;
            }

            time {
                font-size: .9rem;
                font-weight: 700;
            }

            .status {
                padding: 6px 12px;
                border-radius: 100px;
                background: #e6f1e7;
                color: #275434;
                font-size: .75rem;
                font-weight: 750;
            }

            .overdue {
                background: #fbe6df;
                color: #922820;
            }

            .empty {
                padding: 40px 26px;
                text-align: center;
            }

                .empty h3 {
                    font-size: 1.2rem;
                    margin-bottom: 10px;
                }

            .notice {
                margin: 24px 0;
                padding: 18px 22px;
                border: 1px solid #b8d5bb;
                border-radius: 14px;
                background: #e8f3e6;
                color: #1f492f;
                line-height: 1.7;
                overflow-wrap: anywhere;
            }

            .support {
                margin: 28px 0;
                padding: 22px 24px;
                border: 1px dashed #b2c3b4;
                border-radius: 16px;
                display: flex;
                align-items: flex-start;
                gap: 14px;
            }

            .help-icon {
                flex: 0 0 28px;
                height: 28px;
                border: 1px solid #738b80;
                border-radius: 50%;
                display: grid;
                place-items: center;
                font-weight: 700;
            }

            .support strong {
                font-size: .9rem;
            }

            .support p {
                margin: 5px 0 0;
                font-size: .8rem;
            }

            footer {
                width: min(90%, 1200px);
                margin: auto;
                padding: 16px 0 28px;
                display: flex;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 12px;
                font-size: .75rem;
                color: #526b63;
            }

            dialog {
                width: min(90%, 480px);
                border: 1px solid #dce4db;
                border-radius: 22px;
                padding: 30px;
                color: #153b36;
            }

                dialog::backdrop {
                    background: #102c2bd9;
                }

                dialog p {
                    line-height: 1.7;
                }

                dialog button {
                    width: 100%;
                    margin-top: 12px;
                }

            .secondary {
                background: #e3efe8;
                color: #173536;
            }

                .secondary:hover {
                    background: #cbded2;
                }

            #kiosk-accessibility {
                width: min(90%, 1200px);
                margin: auto;
                padding: 8px 0 12px !important;
                border: 0 !important;
                background: transparent !important;
                justify-content: flex-end;
                gap: 8px !important;
            }

                #kiosk-accessibility .accessibility-label {
                    font-size: .75rem;
                    color: #526b63;
                }

                #kiosk-accessibility button {
                    min-height: 44px !important;
                    padding: 8px 12px !important;
                    font-size: .75rem !important;
                    border-width: 1px !important;
                    border-radius: 9px !important;
                }

            html.kiosk-high-contrast .welcome,
            html.kiosk-high-contrast .brand-icon,
            html.kiosk-high-contrast .metric-icon,
            html.kiosk-high-contrast .item-mark,
            html.kiosk-high-contrast .support {
                background: #000 !important;
                color: #fff !important;
                border-color: #fff !important;
            }

            html.kiosk-high-contrast .welcome-copy,
            html.kiosk-high-contrast .metric-label,
            html.kiosk-high-contrast .due-label,
            html.kiosk-high-contrast .brand small {
                color: #fff !important;
            }

            @@media (max-width: 700px) {
                .summary {
                    grid-template-columns: 1fr;
                }

                .welcome .button {
                    width: 100%;
                }

                .loan-details {
                    width: 100%;
                    justify-content: space-between;
                }

                #kiosk-accessibility {
                    justify-content: flex-start;
                }
            }
    </style>
</head>

<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header>
        <div class="brand">
            <span class="brand-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none"
                     stroke="currentColor" stroke-width="1.8">
                    <path d="M16 8C11 4 5 6 4 7v19c4-2 8-2 12 1
                    4-3 8-3 12-1V7c-1-1-7-3-12 1Z" />
                    <path d="M16 8v19" />
                </svg>
            </span>
            <div>
                LibraryLink NT
                <small>A WORLD WITHIN REACH</small>
            </div>
        </div>

        <form method="post"
              action="@Url.Action("EndSession", "Kiosk")"
              id="end-session">
            @Html.AntiForgeryToken()

            <button type="submit" class="finish-button">
                Finish session ↗
            </button>
        </form>
    </header>

    <main id="main-content" tabindex="-1">
        <section class="welcome" aria-labelledby="welcome-heading">
            <div>
                <div class="eyebrow">Your own little corner</div>
                <h1 id="welcome-heading">Hello, @Model.FirstName.</h1>
                <p class="welcome-copy">
                    A new discovery is always around the corner.
                    Ready for your next one?
                </p>
            </div>

            <a href="@Url.Action("Borrow", "Kiosk")" class="button">
                Borrow an item <span aria-hidden="true">→</span>
            </a>
        </section>

        @if (TempData["KioskMessage"] is string message)
        {
            <div class="notice" role="status">@message</div>
        }

        <div class="summary">
            <section class="card" aria-label="Active loans">
                <div class="metric-top">
                    <span class="metric-label">Currently borrowing</span>
                    <span class="metric-icon" aria-hidden="true">↗</span>
                </div>

                <strong class="value">@Model.ActiveLoans.Count</strong>
                <p class="muted metric-note">Items on your account</p>
            </section>

            <section class="card" aria-label="Unpaid assessed fines">
                <div class="metric-top">
                    <span class="metric-label">Unpaid assessed fines</span>
                    <span class="metric-icon" aria-hidden="true">$</span>
                </div>

                <strong class="value">
                    @Model.OutstandingFines.ToString("C", currency)
                </strong>

                <p class="muted metric-note">
                    Further charges may apply when overdue items return.
                </p>
            </section>
        </div>

        <section aria-labelledby="loans-heading">
            <div class="section-heading">
                <h2 id="loans-heading">On your bookshelf</h2>
                <p class="muted">Your current loans and return dates</p>
            </div>

            @if (Model.ActiveLoans.Count == 0)
            {
                <div class="card empty">
                    <h3>A little space for something new.</h3>
                    <p class="muted">
                        You have no active loans.
                        Select “Borrow an item” to get started.
                    </p>
                </div>
            }
            else
            {
                <div class="loans">
                    @foreach (var loan in Model.ActiveLoans)
                    {
                        <article class="card loan">
                            <div class="item-information">
                                <div class="item-mark" aria-hidden="true">↗</div>

                                <div class="item-text">
                                    <h3>@loan.ItemName</h3>
                                    <p class="muted item-code">
                                        @loan.LibraryCode
                                    </p>
                                </div>
                            </div>

                            <div class="loan-details">
                                <div>
                                    <span class="due-label">Return by</span>
                                    <time datetime="@loan.DueDate.ToString("yyyy-MM-dd")">
                                        @loan.DueDate.ToString("dd MMM yyyy")
                                    </time>
                                </div>

                                <span class="status @(loan.IsOverdue ? "overdue" : "")">
                                    @(loan.IsOverdue ? "Overdue" : "On loan")
                                </span>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <aside class="support" aria-label="Help">
            <span class="help-icon" aria-hidden="true">?</span>
            <div>
                <strong>We’re here if you need us.</strong>
                <p class="muted">
                    Visit the service desk for account questions or fine
                    payments. Finish your session before leaving the kiosk.
                </p>
            </div>
        </aside>

        <noscript>
            <p>
                Automatic screen clearing requires JavaScript.
                Use “Finish session” before leaving.
            </p>
        </noscript>
    </main>

    <dialog id="timeout-dialog"
            aria-labelledby="timeout-heading"
            aria-describedby="timeout-description">
        <h2 id="timeout-heading">Still exploring?</h2>

        <p id="timeout-description">
            Your session will finish in
            <strong id="seconds-left">30</strong> seconds.
        </p>

        <button type="button" id="continue-session">
            Yes, keep my session open
        </button>

        <button type="button" id="finish-now" class="secondary">
            Finish now
        </button>
    </dialog>

    <footer>
        <span>LibraryLink NT · Group 11 demonstration</span>
        <span>Your visit. Your discoveries. Your library.</span>
    </footer>

    <script>
            (() => {
                const form = document.getElementById("end-session");
                const dialog = document.getElementById("timeout-dialog");
                const seconds = document.getElementById("seconds-left");
                const continueButton =
                    document.getElementById("continue-session");

                let lastActivity = Date.now();
                let ending = false;

                function finish() {
                    if (ending) return;
                    ending = true;
                    document.body.style.visibility = "hidden";
                    form.requestSubmit();
                }

                function activity() {
                    if (!dialog.open && !ending) {
                        lastActivity = Date.now();
                    }
                }

                ["pointerdown", "keydown", "touchstart"].forEach(event => {
                    document.addEventListener(event, activity, {
                        passive: true
                    });
                });

                continueButton.addEventListener("click", () => {
                    window.location.reload();
                });

                document.getElementById("finish-now")
                    .addEventListener("click", finish);

                dialog.addEventListener("cancel", event => {
                    event.preventDefault();
                });

                function checkTimeout() {
                    if (ending) return;

                    const elapsed = Date.now() - lastActivity;

                    if (elapsed >= 90000) {
                        finish();
                        return;
                    }

                    if (elapsed >= 60000) {
                        seconds.textContent =
                            Math.ceil((90000 - elapsed) / 1000);

                        if (!dialog.open) {
                            dialog.showModal();
                            continueButton.focus();
                        }
                    }
                }

                setInterval(checkTimeout, 1000);
                document.addEventListener("visibilitychange", checkTimeout);

                window.addEventListener("pageshow", event => {
                    if (event.persisted) {
                        window.location.reload();
                    }
                });
            })();
    </script>

    <script src="@Url.Content("~/js/kiosk-accessibility.js")"></script>
</body>
</html>