@model LibraryManagementSystem.ViewModels.KioskBorrowViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Borrow an item | LibraryLink NT</title>

    <style>
        :root {
            font-family: "Segoe UI", system-ui, sans-serif;
            color: #153b36;
            background: #f6f7f2;
        }

        * { box-sizing: border-box; }

        body { margin: 0; }

        a { color: #075e51; }

        :focus-visible {
            outline: 3px solid #ac4800;
            outline-offset: 5px;
        }

        .skip-link {
            position: absolute;
            top: -100px;
            left: 20px;
            padding: 16px;
            background: white;
            z-index: 20;
        }

        .skip-link:focus { top: 16px; }

        header {
            max-width: 1400px;
            margin: auto;
            padding: 24px 5%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 1.25rem;
            font-weight: 800;
            letter-spacing: -.045em;
        }

        .brand-icon {
            display: grid;
            place-items: center;
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: #075e51;
            color: white;
        }

        .brand-icon svg {
            width: 26px;
            height: 26px;
        }

        .brand small {
            display: block;
            color: #526b63;
            font-size: .68rem;
            font-weight: 600;
            letter-spacing: .15em;
        }

        button, .button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            min-height: 56px;
            padding: 14px 22px;
            border: 1px solid transparent;
            border-radius: 12px;
            background: #075e51;
            color: white;
            font: inherit;
            font-weight: 700;
            text-align: center;
            text-decoration: none;
            cursor: pointer;
        }

        button:hover, .button:hover { background: #03483e; }

        button:disabled {
            opacity: .7;
            cursor: wait;
        }

        .finish-button {
            min-height: 52px;
            background: transparent;
            border-color: #aabcb0;
            color: #153b36;
            font-size: .85rem;
        }

        .finish-button:hover { background: #e5ece2; }

        main {
            width: min(90%, 1050px);
            margin: 20px auto 40px;
        }

        .back {
            display: inline-flex;
            align-items: center;
            min-height: 48px;
            margin-bottom: 18px;
            font-size: .85rem;
            font-weight: 650;
            text-decoration: none;
        }

        .back:hover { text-decoration: underline; }

        .workspace {
            display: grid;
            grid-template-columns: .8fr 1.2fr;
            background: white;
            border: 1px solid #dce4db;
            border-radius: 26px;
            overflow: hidden;
            box-shadow: 0 20px 60px #153b3607;
        }

        .guide {
            background: #073f37;
            color: white;
            padding: clamp(26px, 4vw, 42px);
        }

        .eyebrow {
            font-size: .72rem;
            letter-spacing: .16em;
            text-transform: uppercase;
            font-weight: 750;
            color: #c5e3cc;
        }

        h1 {
            margin: 22px 0 18px;
            font-size: clamp(2.2rem, 4vw, 3.3rem);
            line-height: 1.1;
            letter-spacing: -.055em;
        }

        h1 em {
            color: #d8ecad;
            font-family: Georgia, serif;
            font-weight: 400;
        }

        .guide-copy {
            color: #d0e2d9;
            font-size: .9rem;
            line-height: 1.8;
        }

        .steps {
            display: grid;
            gap: 24px;
            margin: 36px 0 0;
            padding: 0;
            list-style: none;
        }

        .steps li {
            display: flex;
            align-items: flex-start;
            gap: 14px;
        }

        .step-number {
            display: grid;
            place-items: center;
            flex: 0 0 32px;
            height: 32px;
            border: 1px solid #7fa497;
            border-radius: 50%;
            color: #d0e2d9;
            font-size: .8rem;
            font-weight: 750;
        }

        .steps [aria-current="step"] .step-number {
            background: #d8ecad;
            color: #153b36;
            border-color: #d8ecad;
        }

        .step-title {
            display: block;
            font-size: .9rem;
            font-weight: 700;
        }

        .step-note {
            display: block;
            margin-top: 4px;
            color: #d0e2d9;
            font-size: .75rem;
            line-height: 1.6;
        }

        .entry {
            padding: clamp(24px, 4vw, 44px);
            min-width: 0;
        }

        .scan-symbol {
            display: grid;
            place-items: center;
            width: 60px;
            height: 60px;
            border: 1px solid #dce6d9;
            border-radius: 18px;
            background: #f2f6ec;
            color: #075e51;
            margin-bottom: 24px;
        }

        .scan-symbol svg {
            width: 34px;
            height: 34px;
        }

        h2 {
            margin: 0 0 12px;
            font-size: 1.8rem;
            line-height: 1.2;
            letter-spacing: -.045em;
        }

        .muted {
            color: #526b63;
            line-height: 1.7;
        }

        label {
            display: block;
            margin: 28px 0 10px;
            font-size: .9rem;
            font-weight: 700;
        }

        input:not([type="hidden"]) {
            width: 100%;
            min-height: 64px;
            padding: 16px 18px;
            border: 1.5px solid #738b80;
            border-radius: 12px;
            background: #fbfcf9;
            color: #153b36;
            font: inherit;
            font-size: 1.1rem;
        }

        input:focus { background: white; }

        input::placeholder { color: #63786f; }

        .help {
            color: #526b63;
            font-size: .8rem;
            line-height: 1.7;
        }

        .error {
            display: block;
            color: #a12622;
            font-size: .9rem;
            line-height: 1.6;
            margin-top: 8px;
        }

        .primary {
            width: 100%;
            margin-top: 22px;
        }

        .secondary {
            background: #edf2e9;
            color: #153b36;
            border-color: #d3dfce;
        }

        .secondary:hover { background: #dfe9d8; }

        .notice {
            margin-bottom: 24px;
            padding: 16px 20px;
            border: 1px solid #b8d5bb;
            border-radius: 12px;
            background: #e8f3e6;
            color: #1f492f;
            line-height: 1.7;
            overflow-wrap: anywhere;
        }

        .item-summary {
            margin: 26px 0 8px;
            padding: 22px;
            border: 1px solid #dce4db;
            border-radius: 16px;
            background: #f8faf5;
        }

        dl { margin: 0; }

        dt {
            color: #526b63;
            font-size: .75rem;
            margin-top: 18px;
        }

        dt:first-child { margin-top: 0; }

        dd {
            margin: 5px 0 0;
            font-size: 1.05rem;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        .due-date {
            color: #075e51;
            font-size: 1.35rem;
        }

        .support {
            margin-top: 28px;
            padding-top: 20px;
            border-top: 1px solid #dce4db;
        }

        .support strong { font-size: .85rem; }

        .support p { margin-bottom: 0; }

        dialog {
            width: min(90%, 480px);
            border: 1px solid #dce4db;
            border-radius: 22px;
            padding: 30px;
            color: #153b36;
        }

        dialog::backdrop { background: #102c2bd9; }

        dialog p { line-height: 1.7; }

        dialog button {
            width: 100%;
            margin-top: 12px;
        }

        footer {
            width: min(90%, 1050px);
            margin: auto;
            padding: 0 0 28px;
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            font-size: .75rem;
            color: #526b63;
        }

        #kiosk-accessibility {
            width: min(90%, 1050px);
            margin: auto;
            padding: 8px 0 12px !important;
            border: 0 !important;
            background: transparent !important;
            justify-content: flex-end;
            gap: 8px !important;
        }

        #kiosk-accessibility .accessibility-label {
            font-size: .75rem;
            color: #526b63;
        }

        #kiosk-accessibility button {
            min-height: 44px !important;
            padding: 8px 12px !important;
            font-size: .75rem !important;
            border-width: 1px !important;
            border-radius: 9px !important;
        }

        html.kiosk-high-contrast .guide,
        html.kiosk-high-contrast .entry,
        html.kiosk-high-contrast .workspace,
        html.kiosk-high-contrast .item-summary,
        html.kiosk-high-contrast .scan-symbol,
        html.kiosk-high-contrast .brand-icon {
            background: #000 !important;
            color: #fff !important;
            border-color: #fff !important;
        }

        html.kiosk-high-contrast .guide-copy,
        html.kiosk-high-contrast .step-note,
        html.kiosk-high-contrast .step-number,
        html.kiosk-high-contrast .step-title,
        html.kiosk-high-contrast .brand small,
        html.kiosk-high-contrast .due-date,
        html.kiosk-high-contrast h1 em {
            color: #fff !important;
        }

        html.kiosk-high-contrast
        .steps [aria-current="step"] .step-number {
            background: #ffff00 !important;
            color: #000 !important;
        }

        @@media (max-width: 760px) {
            .workspace { grid-template-columns: 1fr; }

            .guide { padding: 28px; }

            .steps {
                gap: 16px;
                margin-top: 24px;
            }

            h1 { font-size: 2.5rem; }

            #kiosk-accessibility {
                justify-content: flex-start;
            }
        }
    </style>
</head>

<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header>
        <div class="brand">
            <span class="brand-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none"
                     stroke="currentColor" stroke-width="1.8">
                    <path d="M16 8C11 4 5 6 4 7v19c4-2 8-2 12 1
                             4-3 8-3 12-1V7c-1-1-7-3-12 1Z" />
                    <path d="M16 8v19" />
                </svg>
            </span>
            <div>
                LibraryLink NT
                <small>A WORLD WITHIN REACH</small>
            </div>
        </div>

        <form method="post"
              action="@Url.Action("EndSession", "Kiosk")"
              id="end-session">
            @Html.AntiForgeryToken()
            <button type="submit" class="finish-button">
                Finish session ↗
            </button>
        </form>
    </header>

    <main id="main-content" tabindex="-1">
        <a href="@Url.Action("Account", "Kiosk")" class="back">
            ← Back to my account
        </a>

        <div class="workspace">
            <section class="guide" aria-labelledby="borrow-heading">
                <div class="eyebrow">Take something wonderful home</div>

                <h1 id="borrow-heading">
                    A new find.<br />
                    <em>All yours to borrow.</em>
                </h1>

                <p class="guide-copy">
                    Have your item ready. We’ll guide you through
                    the rest, one simple step at a time.
                </p>

                <ol class="steps" aria-label="Borrowing steps">
                    <li aria-current="@(Model.ReadyToConfirm ? null : "step")">
                        <span class="step-number" aria-hidden="true">1</span>
                        <div>
                            <span class="step-title">Scan your item</span>
                            <span class="step-note">
                                Use the library barcode or enter its code.
                            </span>
                        </div>
                    </li>

                    <li aria-current="@(Model.ReadyToConfirm ? "step" : null)">
                        <span class="step-number" aria-hidden="true">2</span>
                        <div>
                            <span class="step-title">Review and confirm</span>
                            <span class="step-note">
                                Check the item and return date.
                            </span>
                        </div>
                    </li>

                    <li>
                        <span class="step-number" aria-hidden="true">3</span>
                        <div>
                            <span class="step-title">Enjoy your discovery</span>
                            <span class="step-note">
                                Your account will show the completed loan.
                            </span>
                        </div>
                    </li>
                </ol>
            </section>

            <section class="entry" aria-labelledby="entry-heading">
                @if (TempData["KioskMessage"] is string message)
                {
                    <div class="notice" role="status">@message</div>
                }

                <div class="scan-symbol" aria-hidden="true">
                    <svg viewBox="0 0 40 40" fill="none"
                         stroke="currentColor" stroke-width="2">
                        <path d="M12 5H5v7M28 5h7v7M5 28v7h7M35 28v7h-7" />
                        <path d="M12 13v14M17 13v14M23 13v14M28 13v14" />
                        <path d="M3 20h34" stroke-width="1.4" />
                    </svg>
                </div>

                @if (Model.ReadyToConfirm)
                {
                    <h2 id="entry-heading">Looks like a good find.</h2>
                    <p class="muted">
                        Check these details, then confirm your loan.
                    </p>

                    <div class="item-summary">
                        <dl>
                            <dt>Library item</dt>
                            <dd>@Model.ItemName</dd>

                            <dt>Item library code</dt>
                            <dd>@Model.LibraryCode</dd>

                            <dt>Return by</dt>
                            <dd class="due-date">
                                @(Model.DueDate?.ToString("dd MMM yyyy"))
                            </dd>
                        </dl>
                    </div>

                    <form method="post"
                          action="@Url.Action("Confirm", "Kiosk")"
                          id="confirm-loan">
                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="confirmationToken"
                               value="@Model.ConfirmationToken" />

                        <button type="submit" class="primary">
                            Confirm borrowing →
                        </button>
                    </form>

                    <a href="@Url.Action("Borrow", "Kiosk")"
                       class="button secondary primary">
                        Choose a different item
                    </a>
                }
                else
                {
                    <h2 id="entry-heading">What caught your eye?</h2>
                    <p class="muted">
                        Scan or enter the library code on your book,
                        music or toy.
                    </p>

                    <form method="post"
                          action="@Url.Action("Review", "Kiosk")">
                        @Html.AntiForgeryToken()

                        <label for="LibraryCode">Item library code</label>

                        <input type="text"
                               id="LibraryCode"
                               name="LibraryCode"
                               value="@Model.LibraryCode"
                               placeholder="Enter the item’s library code"
                               maxlength="20"
                               required
                               autocomplete="off"
                               autocapitalize="characters"
                               spellcheck="false"
                               aria-describedby="item-help item-error" />

                        <div id="item-error" class="error">
                            @Html.ValidationMessageFor(m => m.LibraryCode)
                        </div>

                        <p id="item-help" class="help">
                            Select the field before using a USB scanner.
                            Use the library’s item label rather than its ISBN.
                        </p>

                        <button type="submit" class="primary">
                            Review this item →
                        </button>
                    </form>
                }

                <aside class="support" aria-label="Help">
                    <strong>A little help goes a long way.</strong>
                    <p class="help">
                        Ask the service desk if an item cannot be borrowed.
                    </p>
                </aside>
            </section>
        </div>

        <noscript>
            <p>
                Automatic screen clearing requires JavaScript.
                Use “Finish session” before leaving.
            </p>
        </noscript>
    </main>

    <dialog id="timeout-dialog"
            aria-labelledby="timeout-heading"
            aria-describedby="timeout-description">
        <h2 id="timeout-heading">Still exploring?</h2>

        <p id="timeout-description">
            Your session will finish in
            <strong id="seconds-left">30</strong> seconds.
            Continuing returns you to item entry.
        </p>

        <button type="button" id="continue-session">
            Continue my session
        </button>

        <button type="button" id="finish-now" class="secondary">
            Finish now
        </button>
    </dialog>

    <footer>
        <span>LibraryLink NT · Group 11 demonstration</span>
        <span>Your visit. Your discoveries. Your library.</span>
    </footer>

    <script>
        (() => {
            const endForm = document.getElementById("end-session");
            const dialog = document.getElementById("timeout-dialog");
            const continueButton =
                document.getElementById("continue-session");
            const seconds = document.getElementById("seconds-left");
            const borrowUrl = '@Url.Action("Borrow", "Kiosk")';

            let lastActivity = Date.now();
            let ending = false;
            let submitting = false;

            function finish() {
                if (ending || submitting) return;
                ending = true;
                document.body.style.visibility = "hidden";
                endForm.requestSubmit();
            }

            function activity() {
                if (!dialog.open && !ending) {
                    lastActivity = Date.now();
                }
            }

            ["pointerdown", "keydown", "touchstart"].forEach(event => {
                document.addEventListener(event, activity, {
                    passive: true
                });
            });

            continueButton.addEventListener("click", () => {
                window.location.replace(borrowUrl);
            });

            document.getElementById("finish-now")
                .addEventListener("click", finish);

            dialog.addEventListener("cancel", event => {
                event.preventDefault();
            });

            function checkTimeout() {
                if (ending || submitting) return;

                const elapsed = Date.now() - lastActivity;

                if (elapsed >= 90000) {
                    finish();
                    return;
                }

                if (elapsed >= 60000) {
                    seconds.textContent =
                        Math.ceil((90000 - elapsed) / 1000);

                    if (!dialog.open) {
                        dialog.showModal();
                        continueButton.focus();
                    }
                }
            }

            setInterval(checkTimeout, 1000);
            document.addEventListener("visibilitychange", checkTimeout);

            window.addEventListener("pageshow", event => {
                if (event.persisted) {
                    window.location.replace(borrowUrl);
                }
            });

            const confirmation =
                document.getElementById("confirm-loan");

            if (confirmation) {
                confirmation.addEventListener("submit", event => {
                    if (submitting) {
                        event.preventDefault();
                        return;
                    }

                    submitting = true;

                    const button =
                        confirmation.querySelector("button");

                    button.disabled = true;
                    button.textContent = "Processing…";
                });
            }
        })();
    </script>

    <script src="@Url.Content("~/js/kiosk-accessibility.js")"></script>
</body>
</html>