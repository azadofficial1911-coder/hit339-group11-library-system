@model LibraryManagementSystem.ViewModels.KioskStartViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <meta name="robots" content="noindex, nofollow" />

    <meta name="theme-color" content="#20211f" />

    <title>Welcome | LibraryLink NT Kiosk</title>

    <style>
        :root {
            color-scheme: light;
            font-family: "Segoe UI", Arial, sans-serif;
            color: #242424;
            background: #f7f5f0;
        }

        * {
            box-sizing: border-box;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            margin: 0;
            background:
                radial-gradient(
                    ellipse at 100% 0%,
                    rgba(233, 188, 98, .12),
                    transparent 45%
                ),
                #f7f5f0;
            line-height: 1.65;
        }

        ::selection {
            background: #e9bc62;
            color: #20211f;
        }

        a {
            color: #705016;
            text-underline-offset: 4px;
        }

        :focus-visible {
            outline: 3px solid #916216;
            outline-offset: 5px;
        }

        .skip-link {
            position: fixed;
            top: -120px;
            left: 16px;
            z-index: 100;
            padding: 14px 20px;
            border-radius: 10px;
            background: #e9bc62;
            color: #20211f;
            font-weight: 700;
        }

        .skip-link:focus {
            top: 16px;
        }

        .kiosk-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 20px;
            padding: 22px clamp(20px, 5vw, 72px);
            border-bottom: 1px solid #dfdbd1;
            background: rgba(255, 255, 255, .65);
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 13px;
            color: #20211f;
            text-decoration: none;
        }

        .brand-mark {
            display: grid;
            place-items: center;
            width: 42px;
            height: 46px;
            border-radius: 12px 12px 4px 12px;
            background: #20211f;
            color: #e9bc62;
            font-family: Georgia, serif;
            font-size: 1.7rem;
        }

        .brand-name {
            font-size: 1.2rem;
            font-weight: 800;
            letter-spacing: -.04em;
        }

        .brand-name span {
            color: #705016;
        }

        .header-links {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px 22px;
        }

        .home-link {
            display: inline-flex;
            align-items: center;
            min-height: 44px;
            font-size: .9rem;
            font-weight: 650;
            text-decoration: none;
        }

        .kiosk-badge {
            padding: 8px 14px;
            border: 1px solid #d9c9a5;
            border-radius: 100px;
            background: #fbf5e8;
            color: #705016;
            font-size: .8rem;
            font-weight: 650;
        }

        .kiosk-main {
            display: grid;
            grid-template-columns: 1.05fr .95fr;
            align-items: center;
            gap: clamp(30px, 5vw, 70px);
            width: min(100%, 1180px);
            margin: auto;
            padding: 56px 24px;
        }

        .welcome-panel {
            position: relative;
            overflow: hidden;
            padding: clamp(28px, 4vw, 48px);
            border: 1px solid #3c3d35;
            border-radius: 28px;
            background:
                radial-gradient(
                    ellipse at 100% 0%,
                    rgba(233, 188, 98, .15),
                    transparent 65%
                ),
                #20211f;
            color: #f5f2e9;
        }

        .eyebrow {
            margin-bottom: 22px;
            color: #e9bc62;
            font-size: .75rem;
            font-weight: 750;
            letter-spacing: .15em;
            text-transform: uppercase;
        }

        h1 {
            margin: 0 0 24px;
            color: #fffdf6;
            font-size: clamp(2.7rem, 4.7vw, 4.4rem);
            line-height: 1.08;
            letter-spacing: -.06em;
        }

        h1 span {
            color: #e9bc62;
            font-family: Georgia, serif;
            font-style: italic;
            font-weight: 400;
        }

        .intro {
            max-width: 390px;
            margin: 0;
            color: #cbc9bf;
            font-size: 1rem;
            line-height: 1.85;
        }

        .steps {
            display: grid;
            gap: 20px;
            margin: 34px 0 0;
            padding: 28px 0 0;
            border-top: 1px solid #49483e;
            list-style: none;
        }

        .steps li {
            display: flex;
            align-items: flex-start;
            gap: 14px;
        }

        .step-number {
            display: grid;
            place-items: center;
            flex: 0 0 34px;
            width: 34px;
            height: 34px;
            border: 1px solid #6c5b36;
            border-radius: 10px;
            background: rgba(233, 188, 98, .08);
            color: #e9bc62;
            font-size: .85rem;
            font-weight: 700;
        }

        .step-copy strong {
            display: block;
            color: #f5f2e9;
            font-size: .9rem;
            font-weight: 650;
        }

        .step-copy p {
            margin: 4px 0 0;
            color: #bbb9af;
            font-size: .8rem;
            line-height: 1.65;
        }

        .entry-card {
            min-width: 0;
            padding: clamp(26px, 4vw, 42px);
            border: 1px solid #e5e0d6;
            border-radius: 26px;
            background: #fff;
            box-shadow: 0 20px 60px rgba(32, 33, 31, .07);
        }

        .card-icon {
            display: grid;
            place-items: center;
            width: 58px;
            height: 58px;
            margin-bottom: 24px;
            border: 1px solid #e4d5b3;
            border-radius: 16px;
            background: #fbf4e5;
            color: #705016;
        }

        .card-icon svg {
            width: 30px;
            height: 30px;
        }

        h2 {
            margin: 0 0 12px;
            color: #20211f;
            font-size: 1.9rem;
            line-height: 1.2;
            letter-spacing: -.045em;
        }

        .muted {
            margin: 0;
            color: #65635e;
            font-size: .95rem;
            line-height: 1.75;
        }

        label {
            display: block;
            margin: 28px 0 10px;
            color: #34332e;
            font-size: .95rem;
            font-weight: 700;
        }

        input {
            width: 100%;
            min-height: 64px;
            padding: 16px;
            border: 2px solid #aaa496;
            border-radius: 13px;
            background: #fffdf8;
            color: #20211f;
            font: inherit;
            font-size: 1.2rem;
            letter-spacing: .04em;
            transition:
                border-color 180ms ease,
                box-shadow 180ms ease;
        }

        input:focus {
            border-color: #916216;
            box-shadow: 0 0 0 4px rgba(145, 98, 22, .12);
        }

        input.input-validation-error {
            border-color: #a52834;
        }

        .help {
            margin: 12px 0 0;
            color: #65635e;
            font-size: .85rem;
            line-height: 1.75;
        }

        .error {
            display: block;
            margin-top: 8px;
            color: #a52834;
            font-size: .9rem;
            font-weight: 650;
            line-height: 1.6;
        }

        .validation-summary-valid,
        .field-validation-valid {
            display: none;
        }

        .validation-summary-errors {
            margin: 20px 0;
            padding: 14px 18px;
            border: 1px solid #ecc4c7;
            border-radius: 12px;
            background: #fff0f1;
            color: #922f38;
            font-size: .9rem;
        }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 20px;
        }

        .start-button {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            width: 100%;
            min-height: 64px;
            margin-top: 24px;
            padding: 17px 22px;
            border: 1px solid #e9bc62;
            border-radius: 13px;
            background: #e9bc62;
            color: #20211f;
            font: inherit;
            font-size: 1rem;
            font-weight: 750;
            cursor: pointer;
            transition:
                transform 180ms ease,
                background-color 180ms ease,
                box-shadow 180ms ease;
        }

        .start-button:hover {
            background: #f1cb80;
        }

        .start-button:active {
            transform: scale(.98);
        }

        .button-arrow {
            font-size: 1.35rem;
            line-height: 1;
        }

        .notice {
            margin-bottom: 24px;
            padding: 16px 18px;
            border: 1px solid #c6dfcd;
            border-radius: 12px;
            background: #edf6ef;
            color: #285d37;
            font-size: .9rem;
            line-height: 1.7;
            overflow-wrap: anywhere;
        }

        .support {
            margin-top: 28px;
            padding-top: 22px;
            border-top: 1px solid #e5e0d6;
        }

        .support strong {
            color: #34332e;
            font-size: .9rem;
        }

        .support .help {
            margin-top: 6px;
        }

        .privacy-note {
            margin: 20px 0 0;
            color: #65635e;
            font-size: .75rem;
            line-height: 1.7;
        }

        .kiosk-footer {
            padding: 22px 24px;
            border-top: 1px solid #e5e0d6;
            color: #65635e;
            font-size: .8rem;
            text-align: center;
        }

        .kiosk-footer p {
            margin: 0;
        }

        @@media (hover: hover) and (pointer: fine) {
            .start-button:hover {
                transform: translateY(-2px) scale(1.035);
                box-shadow: 0 12px 26px rgba(112, 80, 22, .18);
            }
        }

        @@media (max-width: 820px) {
            .kiosk-main {
                grid-template-columns: 1fr;
                gap: 28px;
                max-width: 650px;
                padding-top: 32px;
                padding-bottom: 32px;
            }

            .welcome-panel {
                padding: 30px;
            }

            h1 {
                font-size: clamp(2.5rem, 7vw, 3.5rem);
            }

            .steps {
                gap: 16px;
                margin-top: 24px;
                padding-top: 22px;
            }
        }

        @@media (max-width: 420px) {
            .kiosk-header {
                gap: 14px;
                padding: 18px 20px;
            }

            .header-links {
                justify-content: space-between;
                width: 100%;
            }

            .kiosk-main {
                padding-right: 16px;
                padding-left: 16px;
            }

            .welcome-panel,
            .entry-card {
                padding: 24px;
                border-radius: 20px;
            }

            h2 {
                font-size: 1.65rem;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation: none !important;
                transition: none !important;
            }

            .start-button:hover,
            .start-button:active {
                transform: none !important;
            }
        }
    </style>
</head>

<body>
    <a class="skip-link" href="#card-entry">
        Skip to card entry
    </a>

    <header class="kiosk-header">
        <a class="brand"
           asp-controller="Home"
           asp-action="Index"
           aria-label="LibraryLink NT home">

            <span class="brand-mark" aria-hidden="true">L</span>

            <span class="brand-name">
                LibraryLink <span>NT</span>
            </span>
        </a>

        <div class="header-links">
            <a class="home-link"
               asp-controller="Home"
               asp-action="Index">
                <span aria-hidden="true">←&nbsp;</span>
                Back to website
            </a>

            <span class="kiosk-badge">
                Self-service kiosk
            </span>
        </div>
    </header>

    <main class="kiosk-main">
        <section class="welcome-panel"
                 aria-labelledby="welcome-heading">

            <div class="eyebrow">
                A little discovery starts here
            </div>

            <h1 id="welcome-heading">
                Your card.<br />
                Your library.<br />
                <span>Your next chapter.</span>
            </h1>

            <p class="intro">
                Ready to take something home?
                Start with your library card to open your
                account and explore your borrowing.
            </p>

            <ol class="steps">
                <li>
                    <span class="step-number"
                          aria-hidden="true">1</span>

                    <div class="step-copy">
                        <strong>Scan or enter your card code</strong>
                        <p>
                            Use a connected USB barcode scanner
                            or type your borrower code.
                        </p>
                    </div>
                </li>

                <li>
                    <span class="step-number"
                          aria-hidden="true">2</span>

                    <div class="step-copy">
                        <strong>Check your account and borrow</strong>
                        <p>
                            View your loans and use an item’s
                            library code to borrow.
                        </p>
                    </div>
                </li>

                <li>
                    <span class="step-number"
                          aria-hidden="true">3</span>

                    <div class="step-copy">
                        <strong>Finish your session</strong>
                        <p>
                            End your session before leaving
                            this shared kiosk.
                        </p>
                    </div>
                </li>
            </ol>
        </section>

        <section class="entry-card"
                 id="card-entry"
                 aria-labelledby="start-heading"
                 tabindex="-1">

            @if (TempData["KioskMessage"] is string message)
            {
                <div class="notice" role="status">
                    @message
                </div>
            }

            <div class="card-icon" aria-hidden="true">
                <svg viewBox="0 0 40 40"
                     fill="none"
                     focusable="false">

                    <rect x="4" y="8"
                          width="32" height="24"
                          rx="4"
                          stroke="currentColor"
                          stroke-width="2" />

                    <path d="M11 17V24M15 17V24M20 17V24M23 17V24M28 17V24"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round" />
                </svg>
            </div>

            <h2 id="start-heading">
                Let’s get you started.
            </h2>

            <p class="muted">
                Have your library card ready.
                Your next discovery is waiting.
            </p>

            <form asp-controller="Kiosk"
                  asp-action="Start"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     role="alert"></div>

                <label asp-for="BorrowerCode">
                    Library card code
                </label>

                <input asp-for="BorrowerCode"
                       autocomplete="off"
                       autocapitalize="characters"
                       spellcheck="false"
                       maxlength="20"
                       required
                       aria-describedby="code-help code-error" />

                <span asp-validation-for="BorrowerCode"
                      class="error"
                      id="code-error"></span>

                <p class="help" id="code-help">
                    Select the field, then scan your library card
                    with a connected USB scanner or type
                    the code printed on your card.
                </p>

                <button class="start-button" type="submit">
                    <span>Open my account</span>
                    <span class="button-arrow"
                          aria-hidden="true">→</span>
                </button>
            </form>

            <div class="support">
                <strong>Need a hand?</strong>

                <p class="help">
                    Ask the library service desk for help
                    with your card or account.
                </p>
            </div>

            <p class="privacy-note">
                This is a shared kiosk. Please finish your
                session before you leave.
            </p>
        </section>
    </main>

    <footer class="kiosk-footer">
        <p>
            LibraryLink NT · Group 11 demonstration
        </p>
    </footer>

    <script src="~/js/kiosk-accessibility.js"
            asp-append-version="true"></script>
</body>
</html>