@model LibraryManagementSystem.ViewModels.KioskStartViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Welcome | LibraryLink NT</title>

    <style>
            :root {
                font-family: "Segoe UI", system-ui, sans-serif;
                color: #153b36;
                background: #f6f7f2;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
            }

            a {
                color: #075e51;
            }

            :focus-visible {
                outline: 3px solid #ac4800;
                outline-offset: 5px;
            }

            .skip-link {
                position: absolute;
                left: 20px;
                top: -100px;
                z-index: 20;
                background: white;
                padding: 16px;
            }

                .skip-link:focus {
                    top: 16px;
                }

            header {
                max-width: 1440px;
                margin: auto;
                padding: 26px 5%;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
                flex-wrap: wrap;
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 12px;
                font-size: 1.25rem;
                font-weight: 800;
                letter-spacing: -.045em;
            }

            .brand-icon {
                display: grid;
                place-items: center;
                width: 44px;
                height: 44px;
                border-radius: 14px;
                background: #075e51;
                color: #fff;
            }

                .brand-icon svg {
                    width: 26px;
                    height: 26px;
                }

            .brand small {
                display: block;
                font-size: .68rem;
                letter-spacing: .15em;
                font-weight: 600;
                color: #506963;
            }

            .header-note {
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: .85rem;
                font-weight: 650;
            }

            .dot {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: #087153;
            }

            main {
                width: min(90%, 1280px);
                margin: 20px auto 0;
                display: grid;
                grid-template-columns: 1.12fr 1fr;
                min-height: 650px;
                border: 1px solid #dce4db;
                border-radius: 30px;
                overflow: hidden;
                background: #fff;
                box-shadow: 0 24px 70px #153b3609;
            }

            .hero {
                position: relative;
                overflow: hidden;
                padding: clamp(28px, 4vw, 58px);
                background: #073f37;
                color: #fff;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                gap: 30px;
            }

                .hero::before {
                    content: "";
                    position: absolute;
                    width: 420px;
                    height: 420px;
                    border: 1px solid #ffffff12;
                    border-radius: 50%;
                    right: -240px;
                    top: -190px;
                    pointer-events: none;
                }

            .eyebrow {
                font-size: .72rem;
                letter-spacing: .17em;
                text-transform: uppercase;
                font-weight: 750;
                color: #c5e3cc;
            }

            h1 {
                font-size: clamp(2.6rem, 4.6vw, 4.5rem);
                font-weight: 650;
                letter-spacing: -.06em;
                line-height: 1.06;
                margin: 24px 0 20px;
            }

                h1 em {
                    font-family: Georgia, serif;
                    font-weight: 400;
                    color: #d8ecad;
                }

            .hero-copy {
                max-width: 340px;
                color: #d0e2d9;
                font-size: 1rem;
                line-height: 1.8;
            }

            .illustration {
                position: relative;
                height: 170px;
                margin: 8px 0;
            }

                .illustration svg {
                    width: 100%;
                    height: 100%;
                }

            .hero-bottom {
                display: flex;
                gap: 12px;
                align-items: center;
                border-top: 1px solid #ffffff29;
                padding-top: 20px;
                color: #d0e2d9;
                font-size: .8rem;
            }

                .hero-bottom strong {
                    color: white;
                    font-weight: 650;
                }

            .entry {
                padding: clamp(24px, 4vw, 56px);
                display: flex;
                flex-direction: column;
                justify-content: center;
                min-width: 0;
            }

            .step-label {
                color: #526b63;
                font-size: .75rem;
                text-transform: uppercase;
                letter-spacing: .14em;
                font-weight: 700;
            }

            h2 {
                margin: 14px 0 10px;
                font-size: clamp(1.8rem, 3vw, 2.4rem);
                letter-spacing: -.05em;
                line-height: 1.2;
            }

            .muted {
                color: #526b63;
                line-height: 1.7;
            }

            .scan-symbol {
                width: 60px;
                height: 60px;
                border: 1px solid #dce6d9;
                background: #f2f6ec;
                color: #075e51;
                border-radius: 18px;
                display: grid;
                place-items: center;
                margin-bottom: 26px;
            }

                .scan-symbol svg {
                    width: 34px;
                    height: 34px;
                }

            label {
                display: block;
                font-size: .9rem;
                font-weight: 700;
                margin: 26px 0 10px;
            }

            input {
                width: 100%;
                min-height: 64px;
                padding: 16px 18px;
                border: 1.5px solid #738b80;
                border-radius: 12px;
                font: inherit;
                font-size: 1.1rem;
                color: #153b36;
                background: #fbfcf9;
            }

                input::placeholder {
                    color: #63786f;
                }

                input:focus {
                    border-color: #075e51;
                    background: white;
                }

                input.input-validation-error {
                    border-color: #a12622;
                }

            .help {
                font-size: .8rem;
                color: #526b63;
                line-height: 1.7;
            }

            .error {
                display: block;
                color: #a12622;
                font-size: .9rem;
                line-height: 1.6;
                margin-top: 8px;
            }

            .submit-button {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                width: 100%;
                min-height: 62px;
                padding: 16px 22px;
                margin-top: 24px;
                border: 0;
                border-radius: 12px;
                background: #075e51;
                color: #fff;
                font: inherit;
                font-weight: 700;
                cursor: pointer;
            }

                .submit-button:hover {
                    background: #03483e;
                }

                .submit-button .arrow {
                    font-size: 1.4rem;
                    line-height: 1;
                }

            .notice {
                background: #e8f3e6;
                color: #1f492f;
                padding: 16px;
                border-radius: 12px;
                line-height: 1.6;
                margin-bottom: 24px;
                overflow-wrap: anywhere;
            }

            .support {
                margin-top: 30px;
                padding-top: 22px;
                border-top: 1px solid #e0e7dd;
                display: flex;
                align-items: flex-start;
                gap: 12px;
            }

            .help-icon {
                flex: 0 0 26px;
                height: 26px;
                display: grid;
                place-items: center;
                border: 1px solid #738b80;
                border-radius: 50%;
                font-weight: 750;
                font-size: .85rem;
            }

            .support strong {
                font-size: .85rem;
            }

            .support p {
                margin: 4px 0 0;
            }

            footer {
                width: min(90%, 1280px);
                margin: auto;
                padding: 24px 0;
                display: flex;
                justify-content: space-between;
                gap: 12px;
                flex-wrap: wrap;
                font-size: .75rem;
                color: #526b63;
            }

            /* Restyle the existing accessibility controls on this page. */
            #kiosk-accessibility {
                width: min(90%, 1280px);
                margin: 0 auto;
                padding: 8px 0 12px !important;
                border: 0 !important;
                background: transparent !important;
                justify-content: flex-end;
                gap: 8px !important;
            }

                #kiosk-accessibility .accessibility-label {
                    font-size: .75rem;
                    color: #526b63;
                }

                #kiosk-accessibility button {
                    min-height: 44px !important;
                    padding: 8px 12px !important;
                    font-size: .75rem !important;
                    border-width: 1px !important;
                    border-radius: 9px !important;
                }

            html.kiosk-high-contrast .hero,
            html.kiosk-high-contrast .scan-symbol,
            html.kiosk-high-contrast input,
            html.kiosk-high-contrast .brand-icon {
                background: #000 !important;
                color: #fff !important;
                border-color: #fff !important;
            }

            html.kiosk-high-contrast .hero-copy,
            html.kiosk-high-contrast .hero-bottom,
            html.kiosk-high-contrast .hero-bottom strong,
            html.kiosk-high-contrast .step-label,
            html.kiosk-high-contrast h1 em,
            html.kiosk-high-contrast .brand small,
            html.kiosk-high-contrast .header-note {
                color: #fff !important;
            }

            @@media (min-width: 1500px) {
                main {
                    margin-top: 40px;
                }
            }

            @@media (max-width: 850px) {
                main {
                    grid-template-columns: 1fr;
                    width: min(94%, 650px);
                    margin-top: 12px;
                }

                .hero {
                    gap: 8px;
                }

                h1 {
                    font-size: clamp(2.4rem, 8vw, 3.5rem);
                }

                .illustration {
                    height: 110px;
                }

                .hero-bottom {
                    margin-top: 8px;
                }

                .entry {
                    padding: 30px 24px;
                }

                #kiosk-accessibility {
                    justify-content: flex-start;
                }
            }

            @@media (max-width: 400px) {
                header {
                    padding: 20px 5%;
                }

                main {
                    border-radius: 18px;
                }

                .hero {
                    padding: 26px 22px;
                }

                .entry {
                    padding: 28px 20px;
                }

                .header-note {
                    font-size: .75rem;
                }
            }
    </style>
</head>

<body>
    <a class="skip-link" href="#card-entry">Skip to card entry</a>

    <header>
        <div class="brand">
            <span class="brand-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none"
                     stroke="currentColor" stroke-width="1.8">
                    <path d="M16 8C11 4 5 6 4 7v19c4-2 8-2 12 1
                    4-3 8-3 12-1V7c-1-1-7-3-12 1Z" />
                    <path d="M16 8v19" />
                </svg>
            </span>
            <div>
                LibraryLink NT
                <small>A WORLD WITHIN REACH</small>
            </div>
        </div>

        <div class="header-note">
            <span class="dot" aria-hidden="true"></span>
            Self-service kiosk
        </div>
    </header>

    <main>
        <section class="hero" aria-labelledby="welcome-heading">
            <div>
                <div class="eyebrow">Make room for a little discovery</div>

                <h1 id="welcome-heading">
                    Your next<br />
                    chapter<br />
                    <em>starts here.</em>
                </h1>

                <p class="hero-copy">
                    Familiar favourites. Unexpected discoveries.
                    A whole library waiting for you.
                </p>
            </div>

            <div class="illustration" aria-hidden="true">
                <svg viewBox="0 0 460 170" fill="none">
                    <ellipse cx="230" cy="156" rx="205" ry="10"
                             fill="#032F29" />

                    <rect x="26" y="139" width="408" height="8"
                          rx="4" fill="#B8CEB6" />

                    <rect x="51" y="43" width="39" height="96"
                          rx="4" fill="#E4EDCE" />
                    <path d="M61 58h19M61 64h19M61 123h19"
                          stroke="#617B52" stroke-width="2" />

                    <rect x="96" y="20" width="45" height="119"
                          rx="4" fill="#DEA67B" />
                    <path d="M106 35h25M106 41h25M106 119h25"
                          stroke="#7B452E" stroke-width="2" />

                    <rect x="147" y="57" width="30" height="82"
                          rx="4" fill="#8FB7A2" />
                    <path d="M157 70h10M157 120h10"
                          stroke="#315C47" stroke-width="2" />

                    <g transform="rotate(-12 207 139)">
                        <rect x="188" y="31" width="39" height="108"
                              rx="4" fill="#D7DEAA" />
                        <path d="M198 47h19M198 53h19M198 119h19"
                              stroke="#68713D" stroke-width="2" />
                    </g>

                    <rect x="251" y="118" width="93" height="21"
                          rx="4" fill="#E4EDCE" />
                    <path d="M265 128h65"
                          stroke="#718064" stroke-width="2" />

                    <rect x="260" y="96" width="76" height="20"
                          rx="4" fill="#DEA67B" />

                    <path d="M367 96h44l-6 43h-32l-6-43Z"
                          fill="#C0CCAA" />
                    <path d="M389 97V44M389 76c-24-1-27-18-27-18
                    22-2 27 18 27 18ZM389 62c21-2 25-20 25-20
                    -22 0-25 20-25 20Z"
                          stroke="#A8C89E" stroke-width="5"
                          stroke-linecap="round"
                          stroke-linejoin="round" />
                </svg>
            </div>

            <div class="hero-bottom">
                <span aria-hidden="true">↗</span>
                <span>
                    <strong>Books, music &amp; more.</strong>
                    One simple place to begin.
                </span>
            </div>
        </section>

        <section class="entry" id="card-entry"
                 aria-labelledby="start-heading" tabindex="-1">

            @if (TempData["KioskMessage"] is string message)
            {
                <div class="notice" role="status">@message</div>
            }

            <div class="scan-symbol" aria-hidden="true">
                <svg viewBox="0 0 40 40" fill="none"
                     stroke="currentColor" stroke-width="2">
                    <path d="M12 5H5v7M28 5h7v7M5 28v7h7M35 28v7h-7" />
                    <path d="M12 13v14M17 13v14M23 13v14M28 13v14" />
                    <path d="M3 20h34" stroke-width="1.4" />
                </svg>
            </div>

            <div class="step-label">01 / Start your visit</div>

            <h2 id="start-heading">Hello, reader.</h2>

            <p class="muted">
                Scan your library card or enter your borrower code
                to borrow items and view your account.
            </p>

            <form method="post" action="@Url.Action("Start", "Kiosk")">
                @Html.AntiForgeryToken()

                <label for="BorrowerCode">Borrower code</label>

                <input type="text"
                       id="BorrowerCode"
                       name="BorrowerCode"
                       value="@Model.BorrowerCode"
                       placeholder="Enter your library card code"
                       autocomplete="off"
                       autocapitalize="characters"
                       spellcheck="false"
                       maxlength="20"
                       required
                       aria-describedby="code-help code-error" />

                <div id="code-error" class="error">
                    @Html.ValidationMessageFor(m => m.BorrowerCode)
                </div>

                <p class="help" id="code-help">
                    Using a USB scanner? Select the field first,
                    then scan the barcode on your library card.
                </p>

                <button type="submit" class="submit-button">
                    <span>Open my account</span>
                    <span class="arrow" aria-hidden="true">→</span>
                </button>
            </form>

            <div class="support">
                <span class="help-icon" aria-hidden="true">?</span>
                <div>
                    <strong>A little help goes a long way.</strong>
                    <p class="help">
                        Our service desk can help with your card or account.
                    </p>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <span>LibraryLink NT · Group 11 demonstration</span>
        <span>Your visit. Your discoveries. Your library.</span>
    </footer>

    <script src="@Url.Content("~/js/kiosk-accessibility.js")"></script>
</body>
</html>