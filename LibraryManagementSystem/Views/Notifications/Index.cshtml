@using LibraryManagementSystem.Models
@model LibraryManagementSystem.ViewModels.NotificationsIndexViewModel

@{
    ViewData["Title"] = "Notification Log";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Notification Log</h1>
        <p class="text-muted mb-0">
            Simulated emails and SMS messages. Nothing is sent outside the system.
        </p>
    </div>

    <form asp-action="RunChecks"
          method="post">

        <button type="submit"
                class="btn btn-outline-primary">
            Run reminder checks now
        </button>
    </form>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">
        @successMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index"
              method="get"
              class="row g-3 align-items-end">

            <div class="col-12 col-lg-5">
                <label for="searchTerm"
                       class="form-label">
                    Search
                </label>

                <input id="searchTerm"
                       name="searchTerm"
                       value="@Model.SearchTerm"
                       class="form-control"
                       placeholder="Borrower code, name, email, phone or subject" />
            </div>

            <div class="col-12 col-sm-6 col-lg-2">
                <label for="channel"
                       class="form-label">
                    Channel
                </label>

                <select id="channel"
                        name="channel"
                        class="form-select">

                    <option value="">All channels</option>

                    <option value="Email"
                            selected="@(Model.SelectedChannel == "Email")">
                        Email
                    </option>

                    <option value="Sms"
                            selected="@(Model.SelectedChannel == "Sms")">
                        SMS
                    </option>
                </select>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <label for="eventType"
                       class="form-label">
                    Event
                </label>

                <select id="eventType"
                        name="eventType"
                        class="form-select">

                    <option value="">All events</option>

                    <option value="Borrowed"
                            selected="@(Model.SelectedEvent == "Borrowed")">
                        Borrowed
                    </option>

                    <option value="DueSoon"
                            selected="@(Model.SelectedEvent == "DueSoon")">
                        Due soon
                    </option>

                    <option value="Overdue"
                            selected="@(Model.SelectedEvent == "Overdue")">
                        Overdue
                    </option>

                    <option value="FineAssessed"
                            selected="@(Model.SelectedEvent == "FineAssessed")">
                        Fine assessed
                    </option>

                    <option value="HoldReady"
                            selected="@(Model.SelectedEvent == "HoldReady")">
                        Hold ready
                    </option>
                </select>
            </div>

            <div class="col-12 col-lg-2">
                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary flex-grow-1">
                        Search
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Clear
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!Model.Notifications.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <h2 class="h4">No messages found</h2>

            <p class="text-muted mb-0">
                Messages appear here when items are borrowed, become due, accrue fines or are ready to collect.
            </p>
        </div>
    </div>
}
else
{
    <p class="text-muted">
        Showing @Model.Notifications.Count of @Model.TotalMatching message(s), newest first.
    </p>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <caption class="visually-hidden">
                    Simulated notification messages, newest first
                </caption>

                <thead class="table-light">
                    <tr>
                        <th scope="col">Sent</th>
                        <th scope="col">Channel</th>
                        <th scope="col">Event</th>
                        <th scope="col">To</th>
                        <th scope="col">Message</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var notification in Model.Notifications)
                    {
                        <tr>
                            <td class="text-nowrap">
                                @notification.CreatedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")
                            </td>

                            <td>
                                <span class="badge @(notification.Channel == NotificationChannel.Email ? "bg-primary" : "bg-info text-dark")">
                                    @(notification.Channel == NotificationChannel.Sms ? "SMS" : "Email")
                                </span>
                            </td>

                            <td>@notification.EventType</td>

                            <td>
                                <div>@notification.Borrower.FullName</div>
                                <div class="text-muted small">@notification.Recipient</div>
                            </td>

                            <td>
                                <div class="fw-semibold">@notification.Subject</div>
                                <div class="text-muted small">@notification.Body</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
