@using LibraryManagementSystem.Models

@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string Active(string controller, string? action = null)
    {
        return string.Equals(
                   currentController,
                   controller,
                   StringComparison.OrdinalIgnoreCase)
               &&
               (action == null ||
                string.Equals(
                    currentAction,
                    action,
                    StringComparison.OrdinalIgnoreCase))
            ? "active"
            : "";
    }

    string? CurrentPage(string controller, string? action = null)
    {
        return Active(controller, action) == "active"
            ? "page"
            : null;
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#20211f" />

    <title>@ViewData["Title"] | LibraryLink NT</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/LibraryManagementSystem.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>
        .site-skip-link {
            position: fixed;
            top: -120px;
            left: 16px;
            z-index: 2000;
            padding: 14px 20px;
            border: 2px solid #20211f;
            border-radius: 12px;
            background: #e9bc62;
            color: #20211f;
            font-weight: 700;
            text-decoration: none;
        }

        .site-skip-link:focus {
            top: 16px;
            color: #20211f;
        }

        .brand-copy {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .brand-name {
            font-size: 1.18rem;
            font-weight: 750;
            letter-spacing: -.035em;
        }

        .brand-name span {
            color: #e9bc62;
        }

        .brand-caption {
            color: #c7c5bd;
            font-size: .65rem;
            font-weight: 500;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .library-navbar .kiosk-nav-link {
            border: 1px solid rgba(233, 188, 98, .5);
            background: rgba(233, 188, 98, .08);
            color: #f1cc86 !important;
        }

        .library-navbar .kiosk-nav-link:hover {
            background: #e9bc62;
            color: #20211f !important;
        }

        .footer-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 24px;
        }

        .footer-brand {
            display: block;
            margin-bottom: 4px;
            color: #20211f;
            font-size: 1.1rem;
            font-weight: 750;
            letter-spacing: -.03em;
        }

        .footer-description {
            margin: 0;
            color: #656158;
            font-size: .9rem;
        }

        .footer-links {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px 24px;
        }

        .footer-links a {
            display: inline-flex;
            align-items: center;
            min-height: 44px;
        }

        .footer-bottom {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 8px 24px;
            margin-top: 22px;
            padding-top: 18px;
            border-top: 1px solid #d8d2c5;
            font-size: .8rem;
        }

        @@media (max-width: 575.98px) {
            .brand-name {
                font-size: 1.05rem;
            }

            .brand-caption {
                font-size: .6rem;
                letter-spacing: .08em;
            }

            .footer-content,
            .footer-bottom {
                justify-content: center;
                text-align: center;
            }

            .footer-content > div:first-child {
                width: 100%;
            }

            .footer-links {
                justify-content: center;
            }
        }
    </style>
</head>

<body>
    <a class="site-skip-link" href="#main-content">
        Skip to main content
    </a>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark library-navbar"
             aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index"
                   aria-label="LibraryLink NT home">
                    <span class="brand-copy">
                        <span class="brand-name">
                            LibraryLink <span>NT</span>
                        </span>
                        <span class="brand-caption">
                            Discover something new
                        </span>
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavigation">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @Active("Home", "Index")"
                               asp-controller="Home"
                               asp-action="Index"
                               aria-current="@CurrentPage("Home", "Index")">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @Active("Catalogue")"
                               asp-controller="Catalogue"
                               asp-action="Index"
                               aria-current="@CurrentPage("Catalogue")">
                                Explore Library
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link kiosk-nav-link @Active("Kiosk")"
                               asp-controller="Kiosk"
                               asp-action="Index"
                               aria-current="@CurrentPage("Kiosk")">
                                Self-service Kiosk
                            </a>
                        </li>

                        @if (User.IsInRole(RoleNames.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Admin")"
                                   asp-controller="Admin"
                                   asp-action="Index"
                                   aria-current="@CurrentPage("Admin")">
                                    Admin
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @Active("Import")"
                                   asp-controller="Import"
                                   asp-action="Index"
                                   aria-current="@CurrentPage("Import")">
                                    CSV Import
                                </a>
                            </li>
                        }

                        @if (User.IsInRole(RoleNames.Reception))
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Reception")"
                                   asp-controller="Reception"
                                   asp-action="Index"
                                   aria-current="@CurrentPage("Reception")">
                                    Reception
                                </a>
                            </li>
                        }

                        @if (User.IsInRole(RoleNames.Manager))
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Manager")"
                                   asp-controller="Manager"
                                   asp-action="Index"
                                   aria-current="@CurrentPage("Manager")">
                                    Manager
                                </a>
                            </li>
                        }

                        @if (User.IsInRole(RoleNames.Reception) ||
                             User.IsInRole(RoleNames.Manager))
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Holds")"
                                   asp-controller="Holds"
                                   asp-action="Index"
                                   aria-current="@CurrentPage("Holds")">
                                    Reservations
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @Active("Notifications")"
                                   asp-controller="Notifications"
                                   asp-action="Index"
                                   aria-current="@CurrentPage("Notifications")">
                                    Notifications
                                </a>
                            </li>
                        }
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main class="container main-content"
          id="main-content"
          tabindex="-1">
        @RenderBody()
    </main>

    <footer class="library-footer">
        <div class="container">
            <div class="footer-content">
                <div>
                    <span class="footer-brand">
                        LibraryLink NT
                    </span>
                    <p class="footer-description">
                        Books, music and more. A little discovery every day.
                    </p>
                </div>

                <nav class="footer-links"
                     aria-label="Footer navigation">
                    <a asp-controller="Catalogue"
                       asp-action="Index">
                        Explore Library
                    </a>

                    <a asp-controller="Kiosk"
                       asp-action="Index">
                        Open Kiosk
                    </a>

                    <a asp-controller="Home"
                       asp-action="Privacy">
                        Privacy
                    </a>
                </nav>
            </div>

            <div class="footer-bottom">
                <span>
                    &copy; @DateTime.Now.Year LibraryLink NT
                </span>
                <span>
                    HIT339 · Group 11 demonstration
                </span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>