@using LibraryManagementSystem.Models

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Library Management System
    </title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/LibraryManagementSystem.styles.css"
          asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark library-navbar">
            <div class="container">
                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    Library Management System
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="mainNavigation"
                     class="collapse navbar-collapse">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Catalogue"
                               asp-action="Index">
                                Search Library
                            </a>
                        </li>

                        @if (User.IsInRole(RoleNames.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Admin"
                                   asp-action="Index">
                                    Admin Dashboard
                                </a>
                            </li>
                        }

                        @if (User.IsInRole(RoleNames.Reception))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Reception"
                                   asp-action="Index">
                                    Reception Dashboard
                                </a>
                            </li>
                        }

                        @if (User.IsInRole(RoleNames.Manager))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Manager"
                                   asp-action="Index">
                                    Manager Dashboard
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main class="container main-content"
          role="main">
        @RenderBody()
    </main>

    <footer class="library-footer">
        <div class="container">
            &copy; 2026 - Library Management System

            <span class="mx-2">|</span>

            <a asp-controller="Catalogue"
               asp-action="Index">
                Search Library
            </a>

            <span class="mx-2">|</span>

            <a asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false
    )
</body>
</html>