@model LibraryManagementSystem.Models.ReceptionDesk
@{ ViewData["Title"] = "Reception desk"; }
<h1>@(Model.Id == 0 ? "Add" : "Edit") reception desk</h1>
<form asp-action="Save" method="post" class="col-lg-8">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="All" role="alert" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" /><span asp-validation-for="Code" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="BranchId" class="form-label"></label><select asp-for="BranchId" asp-items="ViewBag.Branches" class="form-select"><option value="">Select a branch</option></select><span asp-validation-for="BranchId" class="text-danger"></span></div>
    <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
    <button type="submit" class="btn btn-primary">Save desk</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
