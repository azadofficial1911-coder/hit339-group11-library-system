@model IEnumerable<LibraryManagementSystem.Models.Branch>

@{
    ViewData["Title"] = "Library branches";
}

<div class="container py-4">
    <h1>Library branches</h1>
    <p class="text-muted">Find branch locations, opening hours, and accessibility information.</p>
    <p>
        <a asp-controller="Branches" asp-action="Create" class="btn btn-primary">
            Add a branch
        </a>
    </p>

    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info" role="status">
            No branches have been added yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <caption>Library branch locations and visitor information</caption>
                <thead>
                    <tr>
                        <th scope="col">Branch</th>
                        <th scope="col">Address</th>
                        <th scope="col">Opening hours</th>
                        <th scope="col">Accessibility</th>
                        <th scope="col">Status</th><th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var branch in Model)
                    {
                        <tr>
                            <th scope="row">@branch.Name <small class="text-muted">(@branch.Code)</small></th>
                            <td>@branch.Address</td>
                            <td>@(string.IsNullOrWhiteSpace(branch.OpeningHours) ? "Contact branch" : branch.OpeningHours)</td>
                            <td>@(string.IsNullOrWhiteSpace(branch.AccessibilityInformation) ? "Contact branch for details" : branch.AccessibilityInformation)</td>
                            <td>@(branch.IsActive ? "Active" : "Inactive")</td>
<td><a asp-action="Edit" asp-route-id="@branch.Id" aria-label="Edit @branch.Name">Edit</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
