@model LibraryManagementSystem.Models.Book
@using LibraryManagementSystem.Models

@{
    ViewData["Title"] = "Add Book";
}

<div class="row justify-content-center">
    <div class="col-xl-8 col-lg-9">
        <div class="mb-4">
            <h1 class="mb-1">Add New Book</h1>

            <p class="text-muted">
                Enter the book's library and publication information.
            </p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="LibraryCode"
                                   class="form-label"></label>

                            <input asp-for="LibraryCode"
                                   class="form-control"
                                   placeholder="Example: BK-1001" />

                            <span asp-validation-for="LibraryCode"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description"
                                   class="form-label"></label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Author" class="form-label"></label>
                            <input asp-for="Author" class="form-control" />
                            <span asp-validation-for="Author"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Genre" class="form-label"></label>
                            <input asp-for="Genre" class="form-control" />
                            <span asp-validation-for="Genre"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Isbn" class="form-label"></label>
                            <input asp-for="Isbn" class="form-control" />
                            <span asp-validation-for="Isbn"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PublicationYear"
                                   class="form-label"></label>

                            <input asp-for="PublicationYear"
                                   class="form-control" />

                            <span asp-validation-for="PublicationYear"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Status"
                                   class="form-label"></label>

                            <select asp-for="Status"
                                    asp-items="Html.GetEnumSelectList<ItemStatus>()"
                                    class="form-select">
                            </select>

                            <span asp-validation-for="Status"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <fieldset class="border rounded p-3">
                                <legend class="float-none w-auto px-2 fs-6">
                                    Accessible book formats
                                </legend>

                                <p id="book-format-help"
                                   class="text-muted small">
                                    Select the formats that apply to this item.
                                    Leave both unchecked for a standard print book.
                                </p>

                                <div class="form-check mb-2">
                                    <input asp-for="IsLargePrint"
                                           class="form-check-input"
                                           aria-describedby="book-format-help" />

                                    <label asp-for="IsLargePrint"
                                           class="form-check-label"></label>
                                </div>

                                <div class="form-check">
                                    <input asp-for="IsAudioBook"
                                           class="form-check-input"
                                           aria-describedby="book-format-help" />

                                    <label asp-for="IsAudioBook"
                                           class="form-check-label"></label>
                                </div>

                                <span asp-validation-for="IsLargePrint"
                                      class="text-danger"></span>

                                <span asp-validation-for="IsAudioBook"
                                      class="text-danger"></span>
                            </fieldset>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            Save Book
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}