@model LibraryManagementSystem.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<div class="row justify-content-center">
    <div class="col-xl-7 col-lg-8">
        <div class="card border-danger shadow-sm">
            <div class="card-body p-4">
                <h1 class="h2 text-danger">Delete Book</h1>

                <p class="lead">
                    Are you sure you want to delete this book?
                </p>

                <div class="alert alert-warning">
                    This action cannot be reversed.
                </div>

                <dl class="row">
                    <dt class="col-sm-4">Library Code</dt>
                    <dd class="col-sm-8">@Model.LibraryCode</dd>

                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">Author</dt>
                    <dd class="col-sm-8">@Model.Author</dd>

                    <dt class="col-sm-4">Genre</dt>
                    <dd class="col-sm-8">@Model.Genre</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">@Model.Status</dd>
                </dl>

                <form asp-action="Delete"
                      asp-route-id="@Model.Id"
                      method="post">

                    <input type="hidden" asp-for="Id" />

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            Delete Book
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>