@model IEnumerable<LibraryManagementSystem.Models.Book>
@using LibraryManagementSystem.Models

@{
    ViewData["Title"] = "Manage Books";

    string currentSearch =
        ViewData["CurrentSearch"]?.ToString() ?? string.Empty;

    ItemStatus? currentStatus =
        ViewData["CurrentStatus"] as ItemStatus?;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Manage Books</h1>
        <p class="text-muted mb-0">
            Add, search, update and manage the library's books.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Add New Book
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-lg-6">
                    <label for="searchString" class="form-label">
                        Search
                    </label>

                    <input id="searchString"
                           name="searchString"
                           value="@currentSearch"
                           class="form-control"
                           placeholder="Search by name, code, author or genre" />
                </div>

                <div class="col-lg-3">
                    <label for="status" class="form-label">
                        Status
                    </label>

                    <select id="status"
                            name="status"
                            class="form-select">
                        <option value="">All statuses</option>

                        @foreach (ItemStatus status in Enum.GetValues<ItemStatus>())
                        {
                            if (currentStatus == status)
                            {
                                <option value="@status" selected>
                                    @status
                                </option>
                            }
                            else
                            {
                                <option value="@status">
                                    @status
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-lg-3">
                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary flex-grow-1">
                            Search
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Clear
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <h2 class="h4">No books found</h2>

            <p class="text-muted">
                Try changing the search filters or add a new book.
            </p>

            <a asp-action="Create" class="btn btn-primary">
                Add New Book
            </a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Library Code</th>
                        <th>Name</th>
                        <th>Author</th>
                        <th>Genre</th>
                        <th>Year</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (Book book in Model)
                    {
                        string statusClass = book.Status switch
                        {
                            ItemStatus.Available => "bg-success",
                            ItemStatus.Borrowed => "bg-primary",
                            ItemStatus.Damaged => "bg-warning text-dark",
                            ItemStatus.Destroyed => "bg-danger",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td>
                                <strong>@book.LibraryCode</strong>
                            </td>

                            <td>@book.Name</td>
                            <td>@book.Author</td>
                            <td>@book.Genre</td>
                            <td>@book.PublicationYear</td>

                            <td>
                                <span class="badge @statusClass">
                                    @book.Status
                                </span>
                            </td>

                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a asp-action="Details"
                                       asp-route-id="@book.Id"
                                       class="btn btn-sm btn-outline-info">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@book.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@book.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}