@model LibraryManagementSystem.ViewModels.BorrowItemViewModel

@{
    ViewData["Title"] = "Borrow Item";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="mb-4">
            <h1>Borrow Item</h1>

            <p class="text-muted">
                Issue an available library item to an active borrower.
            </p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Borrow"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="LibraryCode"
                               class="form-label">
                        </label>

                        <input asp-for="LibraryCode"
                               class="form-control"
                               placeholder="Example: BK-1001"
                               autocomplete="off" />

                        <span asp-validation-for="LibraryCode"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            Enter the unique code shown in the item record.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BorrowerCode"
                               class="form-label">
                        </label>

                        <input asp-for="BorrowerCode"
                               class="form-control"
                               placeholder="Example: BR-1001"
                               autocomplete="off" />

                        <span asp-validation-for="BorrowerCode"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            The borrower must exist and have an active account.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DueDate"
                               class="form-label">
                        </label>

                        <input asp-for="DueDate"
                               class="form-control"
                               min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />

                        <span asp-validation-for="DueDate"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            The standard borrowing period is 14 days.
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit"
                                class="btn btn-primary">
                            Confirm Borrowing
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}