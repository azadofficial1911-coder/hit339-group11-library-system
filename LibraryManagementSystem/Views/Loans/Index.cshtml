@model IEnumerable<LibraryManagementSystem.Models.Loan>

@{
    ViewData["Title"] = "Loan Management";

    string? searchTerm =
        ViewData["SearchTerm"]?.ToString();

    string? selectedStatus =
        ViewData["SelectedLoanStatus"]?.ToString();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Loan Management</h1>
        <p class="text-muted mb-0">
            Manage borrowing, returns and late fines.
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Borrow"
           class="btn btn-primary">
            Borrow Item
        </a>

        <a asp-action="Return"
           class="btn btn-success">
            Return Item
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">
        @successMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">
        @errorMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index"
              method="get"
              class="row g-3 align-items-end">

            <div class="col-12 col-lg-6">
                <label for="searchTerm"
                       class="form-label">
                    Search
                </label>

                <input id="searchTerm"
                       name="searchTerm"
                       value="@searchTerm"
                       class="form-control"
                       placeholder="Item code, item name, borrower code or borrower name" />
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <label for="loanStatus"
                       class="form-label">
                    Loan Status
                </label>

                <select id="loanStatus"
                        name="loanStatus"
                        class="form-select">

                    <option value="">All loans</option>

                    <option value="Active"
                            selected="@(selectedStatus == "Active")">
                        Active
                    </option>

                    <option value="Overdue"
                            selected="@(selectedStatus == "Overdue")">
                        Overdue
                    </option>

                    <option value="Returned"
                            selected="@(selectedStatus == "Returned")">
                        Returned
                    </option>

                    <option value="UnpaidFine"
                            selected="@(selectedStatus == "UnpaidFine")">
                        Unpaid fines
                    </option>
                </select>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary flex-grow-1">
                        Search
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Clear
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <h2 class="h4">No loans found</h2>

            <p class="text-muted">
                Change the search filters or create a new loan.
            </p>

            <a asp-action="Borrow"
               class="btn btn-primary">
                Borrow Item
            </a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Item</th>
                        <th>Borrower</th>
                        <th>Borrowed</th>
                        <th>Due</th>
                        <th>Returned</th>
                        <th>Status</th>
                        <th>Fine</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var loan in Model)
                    {
                        bool isOverdue =
                            loan.ReturnDate == null &&
                            loan.DueDate.Date < DateTime.Today;

                        <tr>
                            <td>
                                <strong>@loan.Item.Name</strong>
                                <div class="small text-muted">
                                    @loan.Item.LibraryCode
                                </div>
                            </td>

                            <td>
                                <strong>@loan.Borrower.FullName</strong>
                                <div class="small text-muted">
                                    @loan.Borrower.BorrowerCode
                                </div>
                            </td>

                            <td>
                                @loan.BorrowDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @loan.DueDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @if (loan.ReturnDate.HasValue)
                                {
                                    @loan.ReturnDate.Value.ToString("dd MMM yyyy")
                                }
                                else
                                {
                                    <span class="text-muted">Not returned</span>
                                }
                            </td>

                            <td>
                                @if (loan.ReturnDate.HasValue)
                                {
                                    <span class="badge bg-secondary">
                                        Returned
                                    </span>
                                }
                                else if (isOverdue)
                                {
                                    <span class="badge bg-danger">
                                        Overdue
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">
                                        Active
                                    </span>
                                }
                            </td>

                            <td>
                                @if (loan.FineAmount > 0)
                                {
                                    <strong>
                                        @loan.FineAmount.ToString("C")
                                    </strong>

                                    @if (loan.FinePaid)
                                    {
                                        <div>
                                            <span class="badge bg-success">
                                                Paid
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div>
                                            <span class="badge bg-warning text-dark">
                                                Unpaid
                                            </span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="d-flex flex-wrap justify-content-end gap-2">
                                    <a asp-action="Details"
                                       asp-route-id="@loan.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Details
                                    </a>

                                    @if (loan.ReturnDate == null)
                                    {
                                        <a asp-action="Return"
                                           class="btn btn-sm btn-outline-success">
                                            Return
                                        </a>
                                    }

                                    @if (loan.ReturnDate.HasValue &&
                                         loan.FineAmount > 0 &&
                                         !loan.FinePaid)
                                    {
                                        <form asp-action="MarkFinePaid"
                                              asp-route-id="@loan.Id"
                                              method="post">

                                            <button type="submit"
                                                    class="btn btn-sm btn-success">
                                                Mark Paid
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}