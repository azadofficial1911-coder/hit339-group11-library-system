@model LibraryManagementSystem.Models.Loan

@{
    ViewData["Title"] = "Loan Details";

    bool isOverdue =
        Model.ReturnDate == null &&
        Model.DueDate.Date < DateTime.Today;

    string loanStatus =
        Model.ReturnDate.HasValue
            ? "Returned"
            : isOverdue
                ? "Overdue"
                : "Active";

    string statusColour =
        Model.ReturnDate.HasValue
            ? "bg-secondary"
            : isOverdue
                ? "bg-danger"
                : "bg-primary";

    DateTime comparisonDate =
        Model.ReturnDate ?? DateTime.Today;

    int lateDays = Math.Max(
        0,
        (comparisonDate.Date - Model.DueDate.Date).Days
    );
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Loan Details</h1>

        <p class="text-muted mb-0">
            Transaction number: @Model.Id
        </p>
    </div>

    <span class="badge @statusColour fs-6">
        @loanStatus
    </span>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <h2 class="h5 mb-0">Library Item</h2>
            </div>

            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Item Name</dt>
                    <dd class="col-sm-7">@Model.Item.Name</dd>

                    <dt class="col-sm-5">Library Code</dt>
                    <dd class="col-sm-7">
                        @Model.Item.LibraryCode
                    </dd>

                    <dt class="col-sm-5">Current Status</dt>
                    <dd class="col-sm-7">
                        @Model.Item.Status
                    </dd>

                    <dt class="col-sm-5">Description</dt>
                    <dd class="col-sm-7">
                        @(string.IsNullOrWhiteSpace(Model.Item.Description)
                            ? "No description"
                            : Model.Item.Description)
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <h2 class="h5 mb-0">Borrower</h2>
            </div>

            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Full Name</dt>
                    <dd class="col-sm-7">
                        @Model.Borrower.FullName
                    </dd>

                    <dt class="col-sm-5">Borrower Code</dt>
                    <dd class="col-sm-7">
                        @Model.Borrower.BorrowerCode
                    </dd>

                    <dt class="col-sm-5">Email</dt>
                    <dd class="col-sm-7">
                        @Model.Borrower.Email
                    </dd>

                    <dt class="col-sm-5">Phone</dt>
                    <dd class="col-sm-7">
                        @(Model.Borrower.PhoneNumber
                            ?? "Not provided")
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header">
                <h2 class="h5 mb-0">
                    Borrowing Information
                </h2>
            </div>

            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-md-4">Borrow Date</dt>
                    <dd class="col-md-8">
                        @Model.BorrowDate.ToString("dd MMMM yyyy")
                    </dd>

                    <dt class="col-md-4">Due Date</dt>
                    <dd class="col-md-8">
                        @Model.DueDate.ToString("dd MMMM yyyy")
                    </dd>

                    <dt class="col-md-4">Return Date</dt>
                    <dd class="col-md-8">
                        @if (Model.ReturnDate.HasValue)
                        {
                            @Model.ReturnDate.Value.ToString(
                                "dd MMMM yyyy"
                            )
                        }
                        else
                        {
                            <span class="text-muted">
                                Not returned
                            </span>
                        }
                    </dd>

                    <dt class="col-md-4">Late Days</dt>
                    <dd class="col-md-8">@lateDays</dd>

                    <dt class="col-md-4">Fine Amount</dt>
                    <dd class="col-md-8">
                        @Model.FineAmount.ToString("C")
                    </dd>

                    <dt class="col-md-4">Fine Status</dt>
                    <dd class="col-md-8">
                        @if (Model.FineAmount <= 0)
                        {
                            <span class="badge bg-secondary">
                                No fine
                            </span>
                        }
                        else if (Model.FinePaid)
                        {
                            <span class="badge bg-success">
                                Paid
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Unpaid
                            </span>
                        }
                    </dd>

                    <dt class="col-md-4">Issued By</dt>
                    <dd class="col-md-8">
                        @Model.IssuedBy
                    </dd>

                    <dt class="col-md-4">Returned By</dt>
                    <dd class="col-md-8">
                        @(Model.ReturnedBy ?? "Not returned")
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mt-4">
    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Loans
    </a>

    @if (Model.ReturnDate == null)
    {
        <a asp-action="Return"
           class="btn btn-success">
            Return Item
        </a>
    }

    @if (Model.ReturnDate.HasValue &&
         Model.FineAmount > 0 &&
         !Model.FinePaid)
    {
        <form asp-action="MarkFinePaid"
              asp-route-id="@Model.Id"
              method="post">

            <button type="submit"
                    class="btn btn-primary">
                Mark Fine as Paid
            </button>
        </form>
    }
</div>