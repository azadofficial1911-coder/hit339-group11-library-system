@model LibraryManagementSystem.Models.Toy
@using LibraryManagementSystem.Models

@{
    ViewData["Title"] = "Edit Toy";
}

<div class="row justify-content-center">
    <div class="col-xl-9 col-lg-10">
        <div class="mb-4">
            <h1 class="display-5 fw-bold mb-1">Edit Toy</h1>
            <p class="text-muted mb-0">
                Update the selected toy's information.
            </p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Edit"
                      asp-route-id="@Model.Id"
                      method="post">

                    <input asp-for="Id" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label">
                                Item Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="LibraryCode"
                                   class="form-label">
                            </label>

                            <input asp-for="LibraryCode"
                                   class="form-control" />

                            <span asp-validation-for="LibraryCode"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ToyType"
                                   class="form-label">
                                Toy Type
                            </label>

                            <input asp-for="ToyType"
                                   class="form-control" />

                            <span asp-validation-for="ToyType"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Manufacturer"
                                   class="form-label">
                            </label>

                            <input asp-for="Manufacturer"
                                   class="form-control" />

                            <span asp-validation-for="Manufacturer"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="RecommendedAge"
                                   class="form-label">
                                Recommended Age
                            </label>

                            <input asp-for="RecommendedAge"
                                   class="form-control"
                                   min="0" />

                            <span asp-validation-for="RecommendedAge"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status"
                                   class="form-label">
                                Item Status
                            </label>

                            <select asp-for="Status"
                                    asp-items="Html.GetEnumSelectList<ItemStatus>()"
                                    class="form-select">
                            </select>

                            <span asp-validation-for="Status"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-12">
                            <label asp-for="SafetyInformation"
                                   class="form-label">
                                Safety Information
                            </label>

                            <textarea asp-for="SafetyInformation"
                                      class="form-control"
                                      rows="3"></textarea>

                            <span asp-validation-for="SafetyInformation"
                                  class="text-danger">
                            </span>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit"
                                class="btn btn-primary">
                            Save Changes
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}