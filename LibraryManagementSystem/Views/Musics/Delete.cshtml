@model LibraryManagementSystem.Models.Music
@using LibraryManagementSystem.Models

@{
    ViewData["Title"] = "Delete Music";

    bool isBorrowed = Model.Status == ItemStatus.Borrowed;

    string statusClass = Model.Status switch
    {
        ItemStatus.Available => "bg-success",
        ItemStatus.Borrowed => "bg-primary",
        ItemStatus.Damaged => "bg-warning text-dark",
        ItemStatus.Destroyed => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="row justify-content-center">
    <div class="col-xl-8 col-lg-9">
        <div class="mb-4">
            <h1 class="display-5 fw-bold mb-1">Delete Music</h1>

            <p class="text-muted mb-0">
                Review this music item before confirming deletion.
            </p>
        </div>

        @if (isBorrowed)
        {
            <div class="alert alert-warning" role="alert">
                <strong>This music item is currently borrowed.</strong>
                It must be returned before it can be deleted.
            </div>
        }
        else
        {
            <div class="alert alert-danger" role="alert">
                <strong>Warning:</strong>
                deleting this music item will permanently remove it from the library.
            </div>
        }

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                    <div>
                        <h2 class="h3 mb-1">@Model.Name</h2>
                        <div class="text-muted">@Model.LibraryCode</div>
                    </div>

                    <span class="badge @statusClass">
                        @Model.Status
                    </span>
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Artist</dt>
                    <dd class="col-sm-8">@Model.Artist</dd>

                    <dt class="col-sm-4">Music Genre</dt>
                    <dd class="col-sm-8">@Model.MusicGenre</dd>

                    <dt class="col-sm-4">Format</dt>
                    <dd class="col-sm-8">@Model.Format</dd>

                    <dt class="col-sm-4">Release Year</dt>
                    <dd class="col-sm-8">@Model.ReleaseYear</dd>

                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">
                        @if (string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <span class="text-muted">
                                No description provided.
                            </span>
                        }
                        else
                        {
                            @Model.Description
                        }
                    </dd>
                </dl>

                <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
                    @if (!isBorrowed)
                    {
                        <form asp-action="Delete"
                              asp-route-id="@Model.Id"
                              method="post">

                            <button type="submit"
                                    class="btn btn-danger">
                                Confirm Delete
                            </button>
                        </form>
                    }

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>