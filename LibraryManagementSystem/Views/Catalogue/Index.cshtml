@using LibraryManagementSystem.Models
@model LibraryManagementSystem.ViewModels.CatalogueSearchViewModel

@{
    ViewData["Title"] = "Search Library";
}

<div class="text-center mb-4">
    <h1>Search Our Library</h1>

    <p class="text-muted">
        Find books, music and toys from any phone, tablet or computer.
    </p>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-controller="Catalogue"
              asp-action="Index"
              method="get"
              class="row g-3 align-items-end">

            <div class="col-12 col-lg-5">
                <label for="searchTerm"
                       class="form-label">
                    Search
                </label>

                <input id="searchTerm"
                       name="searchTerm"
                       value="@Model.SearchTerm"
                       type="search"
                       class="form-control"
                       placeholder="Search by name, code or description" />
            </div>

            <div class="col-12 col-sm-6 col-lg-2">
                <label for="itemType"
                       class="form-label">
                    Item Type
                </label>

                <select id="itemType"
                        name="itemType"
                        class="form-select">

                    <option value="">All types</option>

                    <option value="Book"
                            selected="@(Model.SelectedItemType == "Book")">
                        Books
                    </option>

                    <option value="Music"
                            selected="@(Model.SelectedItemType == "Music")">
                        Music
                    </option>

                    <option value="Toy"
                            selected="@(Model.SelectedItemType == "Toy")">
                        Toys
                    </option>
                </select>
            </div>

            <div class="col-12 col-sm-6 col-lg-2">
                <label for="status"
                       class="form-label">
                    Status
                </label>

                <select id="status"
                        name="status"
                        class="form-select">

                    <option value="">All statuses</option>

                    <option value="Available"
                            selected="@(Model.SelectedStatus == "Available")">
                        Available
                    </option>

                    <option value="Borrowed"
                            selected="@(Model.SelectedStatus == "Borrowed")">
                        Borrowed
                    </option>

                    <option value="Damaged"
                            selected="@(Model.SelectedStatus == "Damaged")">
                        Damaged
                    </option>

                    <option value="Destroyed"
                            selected="@(Model.SelectedStatus == "Destroyed")">
                        Destroyed
                    </option>
                </select>
            </div>

            <div class="col-12 col-lg-3">
                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary flex-grow-1">
                        Search
                    </button>

                    <a asp-controller="Catalogue"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Clear
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Library Items</h2>

    <span class="badge bg-primary">
        @Model.Items.Count result(s)
    </span>
</div>

@if (Model.Items.Count == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <h3 class="h5">No items found</h3>

            <p class="text-muted mb-0">
                Try changing or clearing the search filters.
            </p>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model.Items)
        {
            string statusColour = item.Status switch
            {
                ItemStatus.Available => "bg-success",
                ItemStatus.Borrowed => "bg-primary",
                ItemStatus.Damaged => "bg-warning text-dark",
                ItemStatus.Destroyed => "bg-danger",
                _ => "bg-secondary"
            };

            <div class="col-12 col-md-6 col-xl-4">
                <article class="card shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                            <span class="badge bg-dark">
                                @item.ItemType
                            </span>

                            <span class="badge @statusColour">
                                @item.Status
                            </span>
                        </div>

                        <h3 class="h4">@item.Name</h3>

                        <div class="text-muted small mb-3">
                            Library code:
                            <strong>@item.LibraryCode</strong>
                        </div>

                        <p class="flex-grow-1">
                            @item.Description
                        </p>

                        @if (!string.IsNullOrWhiteSpace(item.PrimaryDetail))
                        {
                            <div class="border-top pt-3">
                                <div>@item.PrimaryDetail</div>

                                <div class="small text-muted mt-1">
                                    @item.SecondaryDetail
                                </div>
                            </div>
                        }
                    </div>

                    <div class="card-footer bg-white">
                        @if (item.Status == ItemStatus.Available)
                        {
                            <span class="text-success fw-semibold">
                                Available to borrow
                            </span>
                        }
                        else if (item.Status == ItemStatus.Borrowed)
                        {
                            <span class="text-primary fw-semibold">
                                Currently on loan
                            </span>
                        }
                        else
                        {
                            <span class="text-danger fw-semibold">
                                Currently unavailable
                            </span>
                        }
                    </div>
                </article>
            </div>
        }
    </div>
}