@model LibraryManagementSystem.Models.Borrower

@{
    ViewData["Title"] = "Register Borrower";
}

<div class="row justify-content-center">
    <div class="col-xl-9 col-lg-10">
        <div class="mb-4">
            <h1 class="display-5 fw-bold mb-1">Register Borrower</h1>
            <p class="text-muted mb-0">
                Enter the borrower's contact and membership details.
            </p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="BorrowerCode"
                                   class="form-label">
                            </label>

                            <input asp-for="BorrowerCode"
                                   class="form-control"
                                   placeholder="Example: BR-1001" />

                            <span asp-validation-for="BorrowerCode"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="FullName"
                                   class="form-label">
                            </label>

                            <input asp-for="FullName"
                                   class="form-control"
                                   autocomplete="name" />

                            <span asp-validation-for="FullName"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email"
                                   class="form-label">
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   type="email"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber"
                                   class="form-label">
                            </label>

                            <input asp-for="PhoneNumber"
                                   class="form-control"
                                   autocomplete="tel" />

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Address"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Address"
                                      class="form-control"
                                      rows="3"
                                      autocomplete="street-address"></textarea>

                            <span asp-validation-for="Address"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DateOfBirth"
                                   class="form-label">
                            </label>

                            <input asp-for="DateOfBirth"
                                   class="form-control"
                                   type="date" />

                            <span asp-validation-for="DateOfBirth"
                                  class="text-danger">
                            </span>

                            <div class="form-text">Optional</div>
                        </div>

                        <div class="col-md-6 d-flex align-items-center">
                            <div class="form-check mt-4">
                                <input asp-for="IsActive"
                                       class="form-check-input" />

                                <label asp-for="IsActive"
                                       class="form-check-label">
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            Register Borrower
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}