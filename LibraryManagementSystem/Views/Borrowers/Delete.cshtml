@model LibraryManagementSystem.Models.Borrower

@{
    ViewData["Title"] = "Delete Borrower";
}

<div class="row justify-content-center">
    <div class="col-xl-8 col-lg-9">
        <div class="mb-4">
            <h1 class="display-5 fw-bold mb-1">Delete Borrower</h1>

            <p class="text-muted mb-0">
                Review the borrower before confirming deletion.
            </p>
        </div>

        <div class="alert alert-danger" role="alert">
            <strong>Warning:</strong>
            this will permanently remove the borrower record.
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="h3 mb-1">@Model.FullName</h2>
                <p class="text-muted">@Model.BorrowerCode</p>

                <dl class="row">
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Phone Number</dt>
                    <dd class="col-sm-8">@Model.PhoneNumber</dd>

                    <dt class="col-sm-4">Address</dt>
                    <dd class="col-sm-8">@Model.Address</dd>

                    <dt class="col-sm-4">Membership</dt>
                    <dd class="col-sm-8">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </dd>
                </dl>

                <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
                    <form asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post">

                        <button type="submit" class="btn btn-danger">
                            Confirm Delete
                        </button>
                    </form>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>